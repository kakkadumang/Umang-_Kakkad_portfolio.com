    // Clean Slate Reset (Restores authentic baseline with INFLIBNET and Events)
    async function cleanSlateReset() {
      if (!confirm("Reset records to standard baseline with genuine Events & INFLIBNET 4 photos?\n\nThis will keep all real portfolio events and visit photos intact.")) return;

      const listSections = ["experience", "events", "education", "certificates", "skills", "projects", "notices"];
      for (const sec of listSections) {
        const val = defaults[sec] || [];
        localStorage.setItem("uk_portfolio_content_" + sec, JSON.stringify(val));
        if (client) {
          try {
            await client.from("portfolio_content").upsert({
              section: sec,
              content: val,
              updated_at: new Date().toISOString()
            }, { onConflict: "section" });
          } catch (_) {}
        }
      }
      try {
        if (typeof BroadcastChannel !== 'undefined') {
          const syncChannel = new BroadcastChannel('portfolio_sync_channel');
          syncChannel.postMessage({ type: 'SECTION_UPDATED', section: 'all', timestamp: Date.now() });
        }
      } catch (_) {}
      alert("Baseline restored with all Events & Gallery photos and INFLIBNET 4 photos! Live website and local site updated.");
      await refreshOverview();
    }
