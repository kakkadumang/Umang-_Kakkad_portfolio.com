    async function loadSection() {
      const b = el("loadBtn");
      b.disabled = true;
      try {
        let loadedFromDb = false;
        if (client) {
          const { data, error } = await client.from("portfolio_content").select("section,content,updated_at").eq("section", currentSection).maybeSingle();
          if (!error && data && data.content !== undefined && data.content !== null) {
            // If events or experience came empty from DB, populate baseline defaults
            if (currentSection === "events" && Array.isArray(data.content) && !data.content.length) {
              currentContent = defaults.events;
            } else if (currentSection === "experience" && Array.isArray(data.content) && !data.content.length) {
              currentContent = defaults.experience;
            } else {
              currentContent = data.content;
            }
            loadedFromDb = true;
          }
        }

        if (!loadedFromDb) {
          const localStored = localStorage.getItem("uk_portfolio_content_" + currentSection);
          if (localStored !== null && localStored !== "[]") {
            try { currentContent = JSON.parse(localStored); } catch(_) {}
          } else {
            currentContent = JSON.parse(JSON.stringify(defaults[currentSection] || []));
          }
        }

        el("recordStatus").textContent = loadedFromDb ? "SAVED IN DATABASE" : "LOCAL / READY";
        renderForm();
        notice(el("editorNotice"), loadedFromDb ? "Loaded records from database. Edit, remove, or add new items." : "Section ready. Add new records and click 'Save Changes' to publish.", "info");
      } catch (e) {
        el("recordStatus").textContent = "OFFLINE MODE";
        const localStored = localStorage.getItem("uk_portfolio_content_" + currentSection);
        if (localStored !== null && localStored !== "[]") {
          try { currentContent = JSON.parse(localStored); } catch(_) {}
        } else {
          currentContent = JSON.parse(JSON.stringify(defaults[currentSection] || []));
        }
        renderForm();
        notice(el("editorNotice"), "Working in local mode. All changes will be saved to local preview and database.", "info");
      } finally {
        b.disabled = false;
      }
    }

    function collectForm() {
      if (currentSection === "about") {
        const d = {};
        el("formEditor").querySelectorAll("[data-key]").forEach(i => d[i.dataset.key] = i.value.trim());
        d.skills = (d.skills || "").split(",").map(x => x.trim()).filter(Boolean);
        return d;
      }
      if (["resume", "site_settings"].includes(currentSection)) {
        const d = {};
        el("formEditor").querySelectorAll("[data-key]").forEach(i => d[i.dataset.key] = i.value.trim());
        return d;
      }
      if (currentSection === "notices") {
        return [...el("formEditor").querySelectorAll("[data-item]")].map(card => ({
          text: card.querySelector('[data-key="text"]')?.value.trim() || ""
        }));
      }
      return [...el("formEditor").querySelectorAll("[data-item]")].map(card => {
        const d = {};
        card.querySelectorAll("[data-key]").forEach(i => d[i.dataset.key] = i.value.trim());
        if (currentSection === "projects") d.tech = (d.tech || "").split(",").map(x => x.trim()).filter(Boolean);
        if (["events", "experience"].includes(currentSection)) {
          const imgList = (card.querySelector('[data-key="images"]')?.value || "").split(/\r?\n/).map(x => x.trim()).filter(Boolean);
          d.images = imgList;
          if (imgList.length && !d.image) d.image = imgList[0];
          delete d.eventImage;
          delete d.experienceImage;
        }
        return d;
      });
    }

    async function saveSection() {
      clearNotice(el("editorNotice"));
      const saveButtons = [el("saveBtn"), el("saveTopBtn"), el("stickySaveBtn")];
      saveButtons.forEach(b => { if (b) { b.disabled = true; b.textContent = "Saving to Cloud Database…"; } });

      try {
        // 1. Verify active authenticated Supabase admin session
        if (!client) setupClient();
        const { data: sessData, error: sessErr } = await client.auth.getSession();
        if (sessErr || !sessData || !sessData.session) {
          const { data: refData, error: refErr } = await client.auth.refreshSession();
          if (refErr || !refData || !refData.session) {
            notice(el("editorNotice"), "⚠️ Admin session expired. Please re-login at login.html to save changes live to the database.", "error");
            el("recordStatus").textContent = "SESSION EXPIRED";
            return;
          }
        }

        const parsed = collectForm();

        // 2. Perform upsert directly into Supabase Cloud Database table portfolio_content
        const { error: dbError } = await client.from("portfolio_content").upsert({
          section: currentSection,
          content: parsed,
          updated_at: new Date().toISOString()
        }, { onConflict: "section" });

        if (dbError) {
          console.error("Supabase upsert error:", dbError);
          notice(el("editorNotice"), "❌ Cloud Database Save Failed: " + (dbError.message || "Permission / RLS issue") + ". Stored only in local preview cache.", "error");
          el("recordStatus").textContent = "DB ERROR";
          return;
        }

        // 3. Update localStorage fallback cache
        localStorage.setItem("uk_portfolio_content_" + currentSection, JSON.stringify(parsed));
        let allStore = {};
        try { allStore = JSON.parse(localStorage.getItem("uk_portfolio_content_all") || "{}"); } catch(_) {}
        allStore[currentSection] = parsed;
        localStorage.setItem("uk_portfolio_content_all", JSON.stringify(allStore));

        if (currentSection === "notices") {
          try {
            const noticeArr = Array.isArray(parsed) ? parsed : [parsed];
            localStorage.setItem("umang_notices_v2", JSON.stringify(noticeArr.map(x => ({ type: "UPDATE", text: x.text || "" }))));
          } catch (_) {}
        }

        // 4. Broadcast instant realtime synchronization across all tabs and local windows
        try {
          if (typeof BroadcastChannel !== 'undefined') {
            const syncChannel = new BroadcastChannel('portfolio_sync_channel');
            syncChannel.postMessage({ type: 'SECTION_UPDATED', section: currentSection, content: parsed, timestamp: Date.now() });
          }
        } catch (_) {}

        currentContent = parsed;
        el("recordStatus").textContent = "SAVED IN CLOUD";
        const timeStr = new Date().toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        notice(el("editorNotice"), `✓ Successfully saved to Cloud Database at ${timeStr}! Both your GitHub Pages site and local site are now updated live — zero git upload required!`, "success");
        await refreshOverview();
      } catch (e) {
        console.error("Save error:", e);
        notice(el("editorNotice"), "Save error: " + (e.message || "Could not complete database save."), "error");
      } finally {
        saveButtons.forEach(b => { if (b) { b.disabled = false; b.textContent = "💾 Save Changes to Database"; } });
        if (el("saveTopBtn")) el("saveTopBtn").textContent = "💾 Save Changes";
      }
    }
    

