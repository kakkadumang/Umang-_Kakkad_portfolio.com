    function generateReviewsPdf(rows, singleTitle = null) {
      if (!rows || !rows.length) {
        alert("No reviews available to generate report.");
        return;
      }
      if (!window.jspdf || !window.jspdf.jsPDF) {
        notice(el("feedbackNotice"), "Loading PDF engine, please wait a moment and try again…", "info");
        return;
      }

      notice(el("feedbackNotice"), "Generating official PDF report with Umang Kakkad signature on every page…", "info");

      try {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({
          orientation: "portrait",
          unit: "pt",
          format: "a4"
        });

        const pageWidth = doc.internal.pageSize.getWidth(); // 595.28 pt
        const pageHeight = doc.internal.pageSize.getHeight(); // 841.89 pt
        const margin = 36;
        const contentW = pageWidth - (margin * 2); // 523.28 pt
        let y = 80;

        const ratings = rows.map(r => Math.max(0, Math.min(5, Number(r.rating) || 5)));
        const avgRating = ratings.length ? (ratings.reduce((a, b) => a + b, 0) / ratings.length).toFixed(1) : "5.0";
        const isSingle = Boolean(singleTitle && rows.length === 1);
        const reportTitle = isSingle ? "OFFICIAL VISITOR REVIEW CERTIFICATE" : "VISITOR REVIEWS & FEEDBACK VERIFICATION REPORT";

        const downloadTimestamp = new Date().toLocaleDateString("en-IN", {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
          hour12: true
        });

        function drawHeader(pageNum) {
          // Top Deep Academic Blue Banner
          doc.setFillColor(0, 51, 153);
          doc.rect(0, 0, pageWidth, 66, "F");

          // Academic Gold/Orange Accent Stripe
          doc.setFillColor(255, 153, 0);
          doc.rect(0, 66, pageWidth, 4, "F");

          // White UK Circle Mark
          doc.setFillColor(255, 255, 255);
          doc.circle(margin + 16, 33, 16, "F");
          doc.setTextColor(0, 51, 153);
          doc.setFont("helvetica", "bold");
          doc.setFontSize(12);
          doc.text("UK", margin + 16, 37, { align: "center" });

          // Header Text
          doc.setTextColor(255, 255, 255);
          doc.setFont("helvetica", "bold");
          doc.setFontSize(13.5);
          doc.text("UMANG KAKKAD · OFFICIAL PORTFOLIO", margin + 42, 28);

          doc.setFont("helvetica", "normal");
          doc.setFontSize(8.5);
          doc.setTextColor(220, 235, 255);
          doc.text(reportTitle, margin + 42, 42);
          // Professional line without university/student mention
          doc.text("Official Portfolio Verification · Verified Testimonials & Client Endorsements", margin + 42, 54);

          // Right Certification Badge
          doc.setFillColor(255, 153, 0);
          doc.roundedRect(pageWidth - margin - 132, 20, 132, 26, 4, 4, "F");
          doc.setTextColor(0, 34, 102);
          doc.setFont("helvetica", "bold");
          doc.setFontSize(8);
          doc.text("OFFICIALLY CERTIFIED", pageWidth - margin - 66, 36, { align: "center" });
        }

        // Draw First Page Header
        drawHeader(1);

        // Page 1 Summary Metric Box
        doc.setFillColor(242, 247, 255);
        doc.setDrawColor(195, 218, 255);
        doc.setLineWidth(1);
        doc.roundedRect(margin, y, contentW, 36, 5, 5, "FD");

        doc.setTextColor(0, 51, 153);
        doc.setFont("helvetica", "bold");
        doc.setFontSize(9.5);
        doc.text(`Total Verified Reviews: ${rows.length}`, margin + 14, y + 15);
        doc.text(`Overall Average Rating: ${avgRating} / 5.0 ★`, margin + 180, y + 15);

        doc.setFont("helvetica", "normal");
        doc.setFontSize(8);
        doc.setTextColor(71, 85, 105);
        doc.text(`Downloaded & Verified On: ${downloadTimestamp}`, margin + 14, y + 28);
        doc.text(`Realtime Cloud Database: Supabase PostgreSQL`, pageWidth - margin - 14, y + 28, { align: "right" });

        y += 48;

        // Loop Through Review Cards
        rows.forEach((r, i) => {
          const name = cleanPdfText([r.first_name, r.last_name].filter(Boolean).join(" ")) || "Visitor";
          const rating = Math.max(0, Math.min(5, Number(r.rating) || 5));
          const starsText = "Rating: " + rating + " / 5";

          doc.setFont("helvetica", "normal");
          doc.setFontSize(9);

          // Clean review text and split into paragraphs then wrap lines
          const rawReview = cleanPdfText(r.review || "No written review text provided.");
          const rawParagraphs = rawReview.split(/\r?\n+/).filter(Boolean);
          let reviewLines = [];
          rawParagraphs.forEach(p => {
            const wrapped = doc.splitTextToSize(p.trim(), contentW - 32);
            reviewLines = reviewLines.concat(wrapped);
          });
          if (!reviewLines.length) reviewLines = ["No written review text provided."];

          // Reply lines
          const rawReply = cleanPdfText(r.admin_reply || "");
          const replyLines = rawReply ? doc.splitTextToSize(rawReply, contentW - 44) : [];

          // Exact card height with generous padding so text never clips
          const cardH = 26 + (reviewLines.length * 14) + (replyLines.length ? (24 + replyLines.length * 13) : 0) + 14;

          // Page Break Check (Footer with signature takes bottom 56 pt)
          if (y + cardH > pageHeight - 64) {
            doc.addPage();
            drawHeader(doc.internal.getNumberOfPages());
            y = 80;
          }

          // Card Background Box
          doc.setFillColor(252, 253, 255);
          doc.setDrawColor(214, 225, 240);
          doc.setLineWidth(0.8);
          doc.roundedRect(margin, y, contentW, cardH, 6, 6, "FD");

          // Left Orange Accent Line
          doc.setFillColor(255, 153, 0);
          doc.roundedRect(margin, y, 4, cardH, 2, 2, "F");

          // Reviewer Name & Number (top left)
          doc.setTextColor(7, 25, 59);
          doc.setFont("helvetica", "bold");
          doc.setFontSize(10.5);
          doc.text("#" + (i + 1) + ". " + name, margin + 14, y + 16);

          // Rating (top right, vertically aligned - NO DATE)
          doc.setTextColor(217, 119, 6);
          doc.setFont("helvetica", "bold");
          doc.setFontSize(9.5);
          doc.text(starsText, pageWidth - margin - 14, y + 16, { align: "right" });

          // Divider Line inside card
          doc.setDrawColor(230, 238, 248);
          doc.line(margin + 14, y + 24, pageWidth - margin - 14, y + 24);

          // Review Text Lines (rendered inside box with 14pt line height)
          doc.setTextColor(15, 23, 42);
          doc.setFont("helvetica", "normal");
          doc.setFontSize(9);
          let textY = y + 38;
          reviewLines.forEach(line => {
            doc.text(line, margin + 14, textY);
            textY += 14;
          });

          // Admin Reply Box (if present)
          if (replyLines.length) {
            const replyBoxY = textY + 4;
            const replyBoxH = 18 + (replyLines.length * 13) + 6;
            doc.setFillColor(238, 245, 255);
            doc.setDrawColor(195, 218, 255);
            doc.roundedRect(margin + 14, replyBoxY, contentW - 28, replyBoxH, 4, 4, "FD");

            doc.setFillColor(0, 51, 153);
            doc.rect(margin + 14, replyBoxY, 3, replyBoxH, "F");

            doc.setTextColor(0, 51, 153);
            doc.setFont("helvetica", "bold");
            doc.setFontSize(8.5);
            doc.text("↩ Official Response by Umang Kakkad:", margin + 22, replyBoxY + 13);

            doc.setTextColor(51, 65, 85);
            doc.setFont("helvetica", "normal");
            doc.setFontSize(8.5);
            let replyTextY = replyBoxY + 26;
            replyLines.forEach(line => {
              doc.text(line, margin + 22, replyTextY);
              replyTextY += 13;
            });
          }

          y += cardH + 12;
        });

        // Official Authorization & Verification Stamp Box at the end
        if (y + 105 > pageHeight - 64) {
          doc.addPage();
          drawHeader(doc.internal.getNumberOfPages());
          y = 80;
        }

        // Authorization Box Container
        doc.setFillColor(253, 254, 255);
        doc.setDrawColor(0, 51, 153);
        doc.setLineWidth(1.2);
        doc.roundedRect(margin, y, contentW, 94, 6, 6, "FD");

        // Left Info
        doc.setFillColor(0, 51, 153);
        doc.roundedRect(margin + 14, y + 12, 134, 20, 3, 3, "F");
        doc.setTextColor(255, 255, 255);
        doc.setFont("helvetica", "bold");
        doc.setFontSize(8);
        doc.text("OFFICIALLY CERTIFIED", margin + 81, y + 25, { align: "center" });

