        blankItem = { title: "", date: "", description: "", image: "" };
      } else if (currentSection === "skills") {
        blankItem = { title: "", date: "Core Skills", description: "" };
      } else if (currentSection === "experience") {
        blankItem = { title: "", date: "", description: "", image: "", images: [] };
      } else if (currentSection === "certificates") {
        blankItem = { title: "", date: "", image: "" };
      } else if (currentSection === "events") {
        blankItem = { title: "", date: "", description: "", images: [] };
      } else if (currentSection === "notices") {
        blankItem = { text: "" };
