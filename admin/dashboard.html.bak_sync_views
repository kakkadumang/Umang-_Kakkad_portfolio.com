    // Download Reviews as CSV
    
    // ==========================================
    // PROFESSIONAL VISITOR REVIEWS PDF & IMAGE EXPORT
    // Genuine .pdf and .png downloads with Umang Kakkad's authentic signature!
    // Seamless on Mobile (Android / iOS) and Laptop / PC (Direct download without print dialogs)
    // ==========================================
    function safeFilePart(str) {
      return String(str || '').normalize("NFKD").replace(/[^a-zA-Z0-9_-]/g, '_').slice(0, 32) || 'Review';
    }

    // Direct Vector Multi-Page PDF Generator with Umang's Signature on EVERY page
    function cleanPdfText(str) {
      if (!str) return "";
      return String(str)
        .replace(/[“”]/g, '"')
        .replace(/[‘’]/g, "'")
        .replace(/[–—]/g, "-")
        .replace(/…/g, "...")
        .replace(/[^\x00-\x7F]/g, "") // safe for standard vector PDF fonts
        .trim();
    }

    function formatReviewDate(dateVal) {
      if (!dateVal) return "Verified Review";
      try {
        const d = new Date(dateVal);
        if (isNaN(d.getTime())) return String(dateVal);
        return d.toLocaleDateString("en-IN", {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit'
        });
      } catch (_) {
        return String(dateVal);
      }
    }

