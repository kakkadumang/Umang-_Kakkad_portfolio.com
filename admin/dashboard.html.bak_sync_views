    // Form Field Builders
    function field(label, key, value, type = "text", placeholder = "") {
      return `<div><label>${label}</label><input data-key="${key}" type="${type}" value="${escapeHtml(value)}" placeholder="${escapeHtml(placeholder)}"></div>`;
    }
    function textareaField(label, key, value, placeholder = "") {
      return `<div><label>${label}</label><textarea data-key="${key}" placeholder="${escapeHtml(placeholder || ('Enter ' + label.toLowerCase()))}">${escapeHtml(value)}</textarea></div>`;
    }
    function uploadField(label, key, value, accept = "image/*") {
      const hasVal = Boolean(value);
      return `<div>
        <label>${label}</label>
        <div style="display:flex;gap:10px;align-items:center">
          <input data-key="${key}" type="text" value="${escapeHtml(value)}" placeholder="Image / file URL or path will appear here" style="flex:1" oninput="updateCardImagePreview(this)">
          ${hasVal ? `<a href="${escapeHtml(value)}" target="_blank" rel="noopener" class="btn btn-secondary" style="min-height:38px;padding:6px 12px;font-size:11px">Open ↗</a>` : ''}
        </div>
        <div class="upload-box">
          <input data-upload="${key}" type="file" accept="${accept}">
          <span class="help">📁 Choose photo from computer to upload & attach immediately</span>
        </div>
        <div class="image-preview-container ${hasVal ? '' : 'hidden'}" data-preview-box="${key}">
          <img src="${escapeHtml(value || '')}" class="image-preview-thumb" alt="Preview" onerror="this.parentElement.classList.add('hidden')">
          <div class="image-preview-info">
            <strong>Photo Linked & Ready</strong>
            <div style="font-size:11px;color:var(--muted);word-break:break-all">${escapeHtml(value ? (value.length > 60 ? value.slice(0,60)+'…' : value) : '')}</div>
          </div>
          <button type="button" class="btn btn-danger" style="min-height:30px;padding:4px 10px;font-size:11px" onclick="clearPhotoField(this, '${key}')">✕ Remove</button>
        </div>
      </div>`;
    }

    window.updateCardImagePreview = function(inp) {
      const key = inp.dataset.key;
      const card = inp.closest(".record-card") || inp.parentElement;
      const box = card.querySelector(`[data-preview-box="${key}"]`);
      if (!box) return;
      const val = inp.value.trim();
      const img = box.querySelector("img");
      if (val) {
        img.src = val;
        box.classList.remove("hidden");
      } else {
        box.classList.add("hidden");
      }
    };

    window.clearPhotoField = function(btn, key) {
      const card = btn.closest(".record-card") || btn.parentElement;
      const inp = card.querySelector(`[data-key="${key}"]`);
      if (inp) inp.value = "";
      const box = card.querySelector(`[data-preview-box="${key}"]`);
      if (box) box.classList.add("hidden");
    };

    function compressImage(file, maxWidth = 1600, quality = 0.85) {
      return new Promise((resolve) => {
        if (!file.type.startsWith("image/")) {
          const r = new FileReader();
          r.onload = () => resolve(r.result);
          r.onerror = () => resolve(null);
          r.readAsDataURL(file);
          return;
        }
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => {
          URL.revokeObjectURL(url);
          let w = img.width, h = img.height;
          if (w > maxWidth || h > maxWidth) {
            if (w > h) { h = Math.round((h * maxWidth) / w); w = maxWidth; }
            else { w = Math.round((w * maxWidth) / h); h = maxWidth; }
          }
          const canvas = document.createElement("canvas");
          canvas.width = w; canvas.height = h;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0, w, h);
          resolve(canvas.toDataURL("image/jpeg", quality));
        };
        img.onerror = () => {
          URL.revokeObjectURL(url);
          const r = new FileReader();
          r.onload = () => resolve(r.result);
          r.onerror = () => resolve(null);
          r.readAsDataURL(file);
        };
        img.src = url;
      });
    }

