          </div>
          <div class="actions" style="margin-top:12px">
            <button class="btn btn-secondary edit-faq" data-id="${row.id}" type="button">✎ Edit</button>
            <button class="btn btn-secondary toggle-faq" data-id="${row.id}" type="button">${row.is_published ? 'Unpublish' : 'Publish'}</button>
            <button class="btn btn-danger delete-faq" data-id="${row.id}" type="button">🗑️ Delete</button>
          </div>
        </div>
      `).join("");

      el("faqList").querySelectorAll(".edit-faq").forEach(btn => {
        btn.addEventListener("click", () => {
          const row = faqRows.find(r => String(r.id) === btn.dataset.id);
          if (!row) return;
          el("faqId").value = row.id;
          el("faqQuestion").value = row.question || "";
          el("faqAnswer").value = row.answer || "";
          el("faqCategory").value = row.category || "General";
          el("faqOrder").value = row.display_order || 0;
          el("faqPublished").checked = Boolean(row.is_published);
          el("faqFormTitle").textContent = "Edit FAQ";
          el("saveFaqBtn").textContent = "Update FAQ";
          el("faqQuestion").focus();
        });
      });
      el("faqList").querySelectorAll(".toggle-faq").forEach(btn => {
        btn.addEventListener("click", async () => {
          const row = faqRows.find(r => String(r.id) === btn.dataset.id);
          if (!row) return;
          try {
            await client.from("faq_items").update({ is_published: !row.is_published }).eq("id", row.id);
            await loadFaqs();
            notice(el("faqNotice"), `FAQ ${row.is_published ? 'unpublished' : 'published'}.`, "success");
          } catch (e) {
            notice(el("faqNotice"), "Could not toggle FAQ: " + e.message, "error");
          }
        });
      });
      el("faqList").querySelectorAll(".delete-faq").forEach(btn => {
        btn.addEventListener("click", async () => {
          if (!confirm("Permanently delete this FAQ?")) return;
          try {
            await client.from("faq_items").delete().eq("id", btn.dataset.id);
            await loadFaqs();
            notice(el("faqNotice"), "FAQ deleted.", "success");
          } catch (e) {
            notice(el("faqNotice"), "Could not delete FAQ: " + e.message, "error");
          }
        });
      });
    }

    async function loadFaqs() {
      clearNotice(el("faqNotice"));
      el("faqList").innerHTML = '<p class="sub">Loading FAQs…</p>';
      try {
        const { data, error } = await client.from("faq_items").select("id,question,answer,category,display_order,is_published").order("display_order", { ascending: true });
        if (error) throw error;
        faqRows = data || [];
        renderFaqs();
        await refreshFaqMetric();
      } catch (e) {
        faqRows = [];
        el("faqList").innerHTML = "";
        notice(el("faqNotice"), "Could not load FAQs: " + (e.message || "Check faq_items table."), "error");
      }
    }

    el("faqForm").addEventListener("submit", async event => {
      event.preventDefault();
      clearNotice(el("faqNotice"));
      const question = el("faqQuestion").value.trim();
      const answer = el("faqAnswer").value.trim();
      const category = el("faqCategory").value.trim() || "General";
      const order = Number(el("faqOrder").value) || 0;
      const isPublished = el("faqPublished").checked;
      const id = el("faqId").value;

      const btn = el("saveFaqBtn");
      btn.disabled = true; btn.textContent = "Saving…";
      try {
        const payload = { question, answer, category, display_order: order, is_published: isPublished };
        if (id) {
          await client.from("faq_items").update(payload).eq("id", id);
        } else {
          await client.from("faq_items").insert(payload);
        }
        el("faqForm").reset();
        el("faqId").value = "";
        el("faqFormTitle").textContent = "Add a New FAQ";
        btn.textContent = "💾 Save FAQ";
        await loadFaqs();
        notice(el("faqNotice"), id ? "FAQ updated successfully!" : "FAQ added successfully!", "success");
      } catch (e) {
        notice(el("faqNotice"), "Could not save FAQ: " + e.message, "error");
      } finally {
        btn.disabled = false;
      }
    });
    el("cancelFaqEditBtn").addEventListener("click", () => {
      el("faqForm").reset();
      el("faqId").value = "";
      el("faqFormTitle").textContent = "Add a New FAQ";
      el("saveFaqBtn").textContent = "💾 Save FAQ";
      clearNotice(el("faqNotice"));
    });
    el("refreshFaqBtn").addEventListener("click", loadFaqs);
    el("faqSearch").addEventListener("input", renderFaqs);

    // Sidebar Navigation Buttons
    document.querySelectorAll(".nav-btn").forEach(button => {
      button.addEventListener("click", async () => {
        const section = button.dataset.section;
        document.querySelectorAll(".nav-btn").forEach(b => b.classList.toggle("active", b === button));

        el("overviewPage").classList.add("hidden");
        el("editorPage").classList.add("hidden");
        el("galleryPage").classList.add("hidden");
        el("feedbackPage").classList.add("hidden");
        el("faqPage").classList.add("hidden");

        if (section === "overview") {
          el("overviewPage").classList.remove("hidden");
          el("stickySectionName").textContent = "Overview";
          await refreshOverview();
        } else if (section === "image_gallery") {
          el("galleryPage").classList.remove("hidden");
          el("stickySectionName").textContent = "Image Gallery";
          await loadStorageGallery();
        } else if (section === "feedback") {
          el("feedbackPage").classList.remove("hidden");
          el("stickySectionName").textContent = "Visitor Feedback";
          await loadFeedback();
        } else if (section === "faq") {
          el("faqPage").classList.remove("hidden");
          el("stickySectionName").textContent = "FAQ Management";
          await loadFaqs();
        } else {
          await openSection(section);
        }
      });
    });

    // Overview Shortcut Cards
    document.querySelectorAll(".shortcut-card").forEach(card => {
      card.addEventListener("click", () => openSection(card.dataset.jump));
    });
    el("goAboutBtn").addEventListener("click", () => openSection("about"));
    el("goExperienceBtn").addEventListener("click", () => openSection("experience"));
    el("goEventsBtn").addEventListener("click", () => openSection("events"));
    el("goProjectsBtn").addEventListener("click", () => openSection("projects"));
    el("refreshOverviewBtn").addEventListener("click", refreshOverview);
    el("refreshGalleryBtn").addEventListener("click", loadStorageGallery);
    el("refreshFeedbackBtn").addEventListener("click", loadFeedback);

    // Logout
    el("logoutBtn").addEventListener("click", async () => {
      el("logoutBtn").disabled = true;
      try { if (client) await client.auth.signOut(); }
      finally { window.location.replace("login.html"); }
    });

    // Start verification on load
    verifyAdmin().then(() => {
      // Dashboard reads current metrics without auto-increment polling
      refreshVisitorStats();
    }).catch(error => {
      el("loadingMessage").textContent = error.message || "Could not verify admin access.";
      el("loadingMessage").className = "notice show error";
    });
  </script>

<!-- Offline Connection Manager Controller -->
<script id="uk-offline-manager-script">
(function() {
    'use strict';

    function getEl(id) { return document.getElementById(id); }

    const overlay = getEl('uk-offline-screen');
    const retryBtn = getEl('uk-offline-btn');
    const btnText = getEl('uk-offline-btn-text');
    const toast = getEl('uk-offline-toast');

    window.ukToggleAccordion = function(item) {
        if (item) item.classList.toggle('active');
    };

    window.ukToggleRecommendations = function() {
        const box = getEl('uk-recommendations-box');
        const arrow = getEl('uk-rec-arrow');
        if (!box) return;
        if (box.style.display === 'none') {
            box.style.display = 'block';
            if (arrow) arrow.textContent = '▾';
        } else {
            box.style.display = 'none';
            if (arrow) arrow.textContent = '▸';
        }
    };

    async function testActualConnection(timeoutMs = 2500) {
        if (!navigator.onLine) return false;
        if (window.location.protocol === 'file:') return true;

        try {
            const controller = new AbortController();
            const timer = setTimeout(() => controller.abort(), timeoutMs);
            await fetch('https://cdn.jsdelivr.net/favicon.ico?_ping=' + Date.now(), {
                method: 'HEAD',
                mode: 'no-cors',
                cache: 'no-store',
                signal: controller.signal
            });
            clearTimeout(timer);
            return true;
        } catch (_) {
            return navigator.onLine;
        }
    }

    function showOfflineScreen() {
        document.documentElement.classList.add('uk-is-offline');
        if (overlay) overlay.style.display = 'flex';
        document.body.style.overflow = 'hidden';

        if (retryBtn) {
            retryBtn.classList.remove('is-loading', 'connected');
        }
        if (btnText) btnText.textContent = 'Refresh / Try Again';
        if (toast) toast.style.display = 'none';
    }

    // Direct site open with NO delays, NO lingering banners
    function hideOfflineScreen(reload = false) {
        document.documentElement.classList.remove('uk-is-offline');
        document.body.style.overflow = '';
        if (overlay) overlay.style.display = 'none';
        if (reload) {
            window.location.reload();
        }
    }

    // Direct immediate site open when connection is restored
    function handleOnlineRestored() {
        hideOfflineScreen(true);
    }

    window.ukRetryConnection = async function() {
        if (!retryBtn) return;
        retryBtn.classList.add('is-loading');
        if (btnText) btnText.textContent = 'Checking...';
        if (toast) toast.style.display = 'none';

        const isOnline = await testActualConnection(2500);

        if (isOnline) {
            // Direct open immediately!
            handleOnlineRestored();
        } else {
            retryBtn.classList.remove('is-loading');
            if (btnText) btnText.textContent = 'Refresh / Try Again';
            if (toast) {
                toast.className = 'uk-offline-toast error';
                toast.textContent = '⚠️ Still offline! Please turn on Wi-Fi or Mobile Data, then try again.';
                toast.style.display = 'block';
            }
        }
    };

    window.addEventListener('offline', () => {
        showOfflineScreen();
    });

    window.addEventListener('online', async () => {
        const reallyOnline = await testActualConnection(2000);
        if (reallyOnline) {
            handleOnlineRestored();
        } else {
            showOfflineScreen();
        }
    });

    // Boot state: If online, DIRECTLY open site (never show offline screen)
    if (!navigator.onLine) {
        showOfflineScreen();
    } else {
        hideOfflineScreen(false);
    }

    if ('serviceWorker' in navigator && (window.location.protocol === 'https:' || window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')) {
        window.addEventListener('load', () => {
            const swPath = window.location.pathname.includes('/admin/') ? '../sw.js' : './sw.js';
            navigator.serviceWorker.register(swPath).catch(() => {});
        });
    }
})();
</script>

