    function escapeHtml(v) {
      return String(v ?? "").replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function setupClient() {
      if (!window.supabase) throw new Error("Supabase library failed to load. Check your internet connection.");
      client = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, {
        auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true }
      });
    }

    async function verifyAdmin() {
      setupClient();

      // 1. Instant UI Unfreeze — Hide loader and reveal dashboard immediately
      const loader = el("loadingScreen");
      if (loader) loader.style.display = "none";
      const app = el("app");
      if (app) app.classList.remove("hidden");

      // 2. Read cached admin user details
      let savedUser = null;
      try {
        savedUser = JSON.parse(sessionStorage.getItem("umang_admin_user") || localStorage.getItem("umang_admin_user") || "null");
      } catch(_) {}

      if (savedUser && savedUser.email) {
        el("adminEmail").textContent = savedUser.email;
        currentUserId = savedUser.userId || "admin";
      } else {
        el("adminEmail").textContent = "Admin";
      }

      // 3. Background non-blocking session verification & content sync
      (async () => {
        let hasActiveSession = false;
        try {
          if (client) {
            const { data } = await Promise.race([
              client.auth.getSession(),
              new Promise(r => setTimeout(() => r({ data: null }), 1800))
            ]);
            if (data?.session?.user?.email) {
              el("adminEmail").textContent = data.session.user.email;
              currentUserId = data.session.user.id;
              hasActiveSession = true;
              const warn = el("authWarningBanner");
              if (warn) warn.style.display = "none";
            }
          }
        } catch (_) {}

        if (!hasActiveSession && (!savedUser || !savedUser.email)) {
          const warn = el("authWarningBanner");
          if (warn) warn.style.display = "flex";
        }

        try { await autoSyncInitialContent(hasActiveSession); } catch(_) {}
        try { await refreshOverview(); } catch(_) {}
      })();

      return true;
    }

