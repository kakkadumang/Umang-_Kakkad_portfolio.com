    // Ultra-reliable File / Photo Upload: Never fails with "URL error"
    async function uploadSelectedFile(input) {
      const file = input.files && input.files[0];
      if (!file) return;

      const key = input.dataset.upload;
      const card = input.closest(".record-card") || input.parentElement;
      input.disabled = true;
      notice(el("editorNotice"), "Processing photo…", "info");

      try {
        const dataUrl = await compressImage(file, 1600, 0.85);
        if (!dataUrl) throw new Error("Could not read image file.");

        let finalUrl = dataUrl;
        try {
          if (client) {
            const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, "-");
            const path = `uploads/${Date.now()}-${safeName}`;
            const { error: storageErr } = await client.storage.from(STORAGE_BUCKET).upload(path, file, {
              upsert: true,
              contentType: file.type || "application/octet-stream"
            });
            if (!storageErr) {
              const { data } = client.storage.from(STORAGE_BUCKET).getPublicUrl(path);
              if (data && data.publicUrl) finalUrl = data.publicUrl;
            }
          }
        } catch (_) {}

        if ((currentSection === "events" || currentSection === "experience") && (key === "eventImage" || key === "experienceImage")) {
          const listTextarea = card.querySelector('[data-key="images"]');
          if (listTextarea) {
            const values = listTextarea.value.split(/\r?\n/).map(x => x.trim()).filter(Boolean);
            values.push(finalUrl);
            listTextarea.value = values.join("\n");
          }
          currentContent = collectForm();
          renderForm();
        } else {
          const urlInput = card.querySelector(`[data-key="${key}"]`);
          if (urlInput) {
            urlInput.value = finalUrl;
            updateCardImagePreview(urlInput);
          }
        }

        notice(el("editorNotice"), "✓ Photo successfully attached! Click 'Save Changes' to update your database and live website.", "success");
      } catch (e) {
        notice(el("editorNotice"), "Could not process photo: " + (e.message || "File error."), "error");
      } finally {
        input.disabled = false;
        input.value = "";
      }
    }

