    function attachCardHandlers() {
      const host = el("formEditor");
      host.querySelectorAll(".remove-item").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.dataset.index);
          if (confirm("Remove this record from the editor? Remember to click 'Save Changes' to apply this change to your live database.")) {
            currentContent = collectForm();
            currentContent.splice(idx, 1);
            renderForm();
            notice(el("editorNotice"), "Record removed. Click 'Save Changes' to update your database.", "info");
          }
        });
      });

      host.querySelectorAll(".move-item").forEach(btn => {
        btn.addEventListener("click", () => {
          const idx = Number(btn.dataset.index);
          const dir = Number(btn.dataset.dir);
          const newIdx = idx + dir;
          currentContent = collectForm();
          if (newIdx >= 0 && newIdx < currentContent.length) {
            const item = currentContent.splice(idx, 1)[0];
            currentContent.splice(newIdx, 0, item);
            renderForm();
            notice(el("editorNotice"), "Record order changed. Click 'Save Changes' to save.", "info");
          }
        });
      });
    }

