<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Workspace | Umang Kakkad</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#003399">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --blue: #003399;
      --blue-dark: #002266;
      --blue-light: #edf4ff;
      --blue-border: #c3d9ff;
      --orange: #ff9900;
      --orange-hover: #e68a00;
      --orange-light: #fff7eb;
      --navy: #07193b;
      --navy-sidebar: #061533;
      --ink: #0f172a;
      --muted: #475569;
      --line: #e2e8f0;
      --bg: #f4f7fb;
      --green: #15803d;
      --green-bg: #f0fdf4;
      --green-border: #bbf7d0;
      --red: #b91c1c;
      --red-bg: #fef2f2;
      --red-border: #fecaca;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: radial-gradient(ellipse at 95% 0%, rgba(255,153,0,.06), transparent 32%),
                  radial-gradient(ellipse at 5% 20%, rgba(0,51,153,.06), transparent 30%),
                  var(--bg);
      color: var(--ink);
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    button, input, textarea, select { font: inherit; }
    button { cursor: pointer; }
    a { color: inherit; text-decoration: none; }

    /* Top Navigation Bar */
    .topbar {
      height: 72px;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(12px);
      border-bottom: 3px solid var(--orange);
      box-shadow: 0 4px 20px rgba(0, 34, 102, 0.05);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 clamp(16px, 3.5vw, 44px);
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
      color: var(--navy);
      font-size: 15px;
      letter-spacing: -0.2px;
    }
    .mark {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, var(--blue), var(--navy));
      color: white;
      border-radius: 50%;
      border: 2.5px solid var(--orange);
      box-shadow: 0 3px 10px rgba(0, 51, 153, 0.22);
      font-weight: 800;
      font-size: 15px;
      font-family: Manrope, sans-serif;
    }
    .brand-titles { display: flex; flex-direction: column; }
    .brand-name { font-weight: 800; color: var(--navy); font-size: 15px; }
    .brand-sub { color: var(--muted); font-size: 11px; font-weight: 600; }
    .top-actions { display: flex; align-items: center; gap: 10px; }
    .live-indicator {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: var(--green-bg);
      border: 1px solid var(--green-border);
      color: var(--green);
      border-radius: 99px;
      font-size: 11px;
      font-weight: 750;
      letter-spacing: 0.3px;
    }
    .live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.16);
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: .6; transform: scale(1.15); }
    }
    .admin-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      background: var(--blue-light);
      border: 1px solid var(--blue-border);
      color: var(--blue);
      border-radius: 10px;
      font-size: 12px;
      font-weight: 700;
    }

    /* Layout */
    .layout {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      min-height: calc(100vh - 72px);
      flex: 1;
    }
    aside {
      background: linear-gradient(180deg, #07193b 0%, #002b80 75%, #051430 100%);
      border-right: 4px solid var(--orange);
      padding: 22px 14px 40px;
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 72px;
      height: calc(100vh - 72px);
      overflow-y: auto;
      box-shadow: 6px 0 24px rgba(7, 25, 59, 0.08);
    }
    .nav-label {
      color: #ffc966;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 1.8px;
      margin: 4px 10px 14px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .nav-btn {
      display: flex;
      width: 100%;
      text-align: left;
      align-items: center;
      gap: 12px;
      padding: 11px 14px;
      border: 1px solid transparent;
      background: transparent;
      border-radius: 10px;
      color: #e2edff;
      font-size: 13px;
      font-weight: 650;
      margin: 2px 0;
      transition: all 0.16s ease;
    }
    .nav-btn:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.18);
      color: #fff;
      transform: translateX(3px);
    }
    .nav-btn.active {
      background: #ffffff;
      color: var(--blue);
      border-color: #ffb02e;
      font-weight: 800;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.14), inset 4px 0 var(--orange);
    }
    .aside-foot {
      margin-top: auto;
      padding: 18px 8px 4px;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      color: #c0d7ff;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.8px;
      line-height: 1.6;
    }

    /* Main Content */
    main {
      padding: clamp(22px, 3vw, 44px);
      padding-bottom: 140px;
      max-width: 1380px;
      width: 100%;
      margin: 0 auto;
    }
    .page-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 24px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--line);
      flex-wrap: wrap;
    }
    h1 {
      font-family: Manrope, Inter, sans-serif;
      font-size: clamp(24px, 2.5vw, 30px);
      letter-spacing: -0.6px;
      font-weight: 800;
      color: var(--navy);
    }
    h2 {
      font-family: Manrope, Inter, sans-serif;
      font-size: 17px;
      font-weight: 750;
      color: var(--navy);
      margin-bottom: 6px;
    }
    .sub {
      color: var(--muted);
      font-size: 13px;
      line-height: 1.65;
    }
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 99px;
      background: var(--blue-light);
      border: 1px solid var(--blue-border);
      color: var(--blue);
      font-size: 11px;
      font-weight: 750;
      letter-spacing: 0.3px;
    }

    /* Cards & Stats Grid */
    .card {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: clamp(18px, 2.2vw, 26px);
      box-shadow: 0 4px 18px rgba(7, 25, 59, 0.04);
      margin-bottom: 20px;
      position: relative;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 22px;
    }
    .stat-card {
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 20px 22px;
      box-shadow: 0 6px 20px rgba(7, 25, 59, 0.035);
      position: relative;
      overflow: hidden;
      border-top: 3px solid var(--orange);
      transition: transform 0.16s ease, box-shadow 0.16s ease;
    }
    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 26px rgba(7, 25, 59, 0.08);
    }
    .stat-card .metric {
      font-family: Manrope, Inter, sans-serif;
      font-size: 32px;
      font-weight: 800;
      color: var(--blue);
      line-height: 1.1;
      margin: 8px 0 4px;
    }
    .stat-card .metric-label {
      font-size: 12px;
      font-weight: 750;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
    }
    .stat-card .metric-desc {
      font-size: 12px;
      color: var(--muted);
      margin-top: 6px;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 42px;
      padding: 10px 18px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 750;
      background: linear-gradient(135deg, var(--blue), var(--navy));
      color: #ffffff;
      border: 1px solid var(--blue);
      box-shadow: 0 4px 12px rgba(0, 51, 153, 0.18);
      transition: all 0.16s ease;
      text-decoration: none;
    }
    .btn:hover {
      background: linear-gradient(135deg, #0947ba, var(--blue));
      box-shadow: 0 6px 16px rgba(0, 51, 153, 0.26);
      transform: translateY(-1px);
    }
    .btn:active { transform: translateY(1px); }
    .btn:disabled { opacity: 0.6; cursor: wait; transform: none; }
    .btn-secondary {
      background: #ffffff;
      color: var(--blue);
      border: 1px solid #cbd8ec;
      box-shadow: 0 2px 6px rgba(7, 25, 59, 0.03);
    }
    .btn-secondary:hover {
      background: var(--blue-light);
      border-color: #9bb7ea;
      color: var(--blue-dark);
    }
    .btn-danger {
      background: #ffffff;
      color: var(--red);
      border: 1px solid var(--red-border);
      box-shadow: none;
    }
    .btn-danger:hover {
      background: var(--red-bg);
      border-color: #fca5a5;
    }
    .btn-orange {
      background: linear-gradient(135deg, var(--orange), #f57c00);
      border-color: var(--orange);
      color: #fff;
      box-shadow: 0 4px 12px rgba(255, 153, 0, 0.25);
    }
    .btn-orange:hover {
      background: linear-gradient(135deg, #fb8c00, #e65100);
    }
    .actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    /* Form Fields */
    label {
      display: block;
      font-size: 12px;
      font-weight: 750;
      color: #1e3a66;
      margin: 16px 0 6px;
    }
    input, textarea, select {
      width: 100%;
      border: 1px solid #cbd5e1;
      border-radius: 9px;
      padding: 12px 14px;
      outline: none;
      background: #ffffff;
      color: var(--ink);
      font-size: 13px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    input:focus, textarea:focus, select:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(0, 51, 153, 0.12);
    }
    textarea {
      min-height: 100px;
      resize: vertical;
      line-height: 1.6;
    }
    input::placeholder, textarea::placeholder { color: #94a3b8; }
    .help {
      font-size: 12px;
      color: var(--muted);
      line-height: 1.6;
      margin-top: 6px;
    }
    .upload-box {
      margin-top: 8px;
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }
    .upload-box input[type="file"] {
      max-width: 290px;
      font-size: 12px;
      padding: 8px 10px;
    }

    /* Image Preview Widget */
    .image-preview-container {
      margin-top: 10px;
      padding: 10px 14px;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .image-preview-thumb {
      width: 72px;
      height: 72px;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      background: #fff;
    }
    .image-preview-info {
      flex: 1;
      font-size: 12px;
      color: #334155;
    }

    /* Multi Photo Gallery Box */
    .gallery-preview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 12px;
      margin-top: 12px;
    }
    .gallery-preview-card {
      position: relative;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }
    .gallery-preview-card img {
      width: 100%;
      height: 95px;
      object-fit: cover;
      display: block;
    }
    .gallery-preview-card .remove-photo-btn {
      position: absolute;
      top: 4px;
      right: 4px;
      background: rgba(185, 28, 28, 0.9);
      color: #fff;
      border: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      font-size: 11px;
      line-height: 22px;
      text-align: center;
      cursor: pointer;
      box-shadow: 0 1px 4px rgba(0,0,0,0.3);
    }
    .gallery-preview-card .remove-photo-btn:hover {
      background: #b91c1c;
      transform: scale(1.1);
    }

    /* Notices & Alerts */
    .notice {
      display: none;
      border-radius: 12px;
      padding: 14px 16px;
      font-size: 13px;
      line-height: 1.6;
      margin-top: 16px;
      overflow-wrap: anywhere;
    }
    .notice.show { display: block; }
    .notice.error { background: var(--red-bg); border: 1px solid var(--red-border); color: var(--red); }
    .notice.success { background: var(--green-bg); border: 1px solid var(--green-border); color: var(--green); }
    .notice.info { background: var(--blue-light); border: 1px solid var(--blue-border); color: var(--blue); }

    /* Record Items in Editor */
    .record-card {
      border: 1px solid #cbd5e1;
      border-left: 5px solid var(--orange) !important;
      border-radius: 14px;
      padding: 22px;
      margin-bottom: 22px;
      background: #ffffff;
      box-shadow: 0 4px 18px rgba(7, 25, 59, 0.035);
      transition: box-shadow 0.16s ease;
    }
    .record-card:hover {
      box-shadow: 0 6px 24px rgba(7, 25, 59, 0.07);
    }
    .record-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      padding-bottom: 14px;
      border-bottom: 1px solid #edf2f9;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }
    .record-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--blue-light);
      color: var(--blue);
      border: 1px solid var(--blue-border);
      padding: 4px 10px;
      border-radius: 8px;
      font-weight: 800;
      font-size: 12px;
    }
    .record-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Quick Shortcuts Grid on Overview */
    .shortcut-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 12px;
      margin-top: 14px;
    }
    .shortcut-card {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      background: #ffffff;
      border: 1px solid var(--line);
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.16s ease;
    }
    .shortcut-card:hover {
      border-color: var(--blue);
      background: var(--blue-light);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(0, 51, 153, 0.08);
    }
    .shortcut-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: var(--blue-light);
      color: var(--blue);
      display: grid;
      place-items: center;
      font-size: 16px;
      flex-shrink: 0;
    }
    .shortcut-name {
      font-weight: 750;
      color: var(--navy);
      font-size: 13px;
    }
    .shortcut-sub {
      color: var(--muted);
      font-size: 11px;
    }

    /* Sticky Bottom Update Bar */
    .sticky-update-bar {
      position: fixed;
      left: 260px;
      right: 0;
      bottom: 0;
      z-index: 40;
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(12px);
      border-top: 3px solid var(--orange);
      box-shadow: 0 -8px 24px rgba(7, 25, 59, 0.1);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px clamp(16px, 3.5vw, 44px);
    }
    .sticky-update-copy strong { color: var(--navy); font-size: 14px; display: block; }
    .sticky-update-copy span { color: var(--muted); font-size: 12px; }
    #stickySaveBtn { min-width: 220px; min-height: 46px; font-size: 13px; }

    /* Visitor Feedback & FAQs */
    .feedback-card {
      border-left: 4px solid var(--blue) !important;
      background: linear-gradient(145deg, #ffffff 0%, #fbfdff 100%) !important;
    }
    .feedback-avatar {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: var(--blue-light);
      color: var(--blue);
      display: grid;
      place-items: center;
      font-weight: 800;
      font-size: 14px;
    }
    .feedback-reply {
      margin-top: 14px;
      padding: 14px 16px;
      border: 1px solid var(--blue-border);
      background: #f6f9ff;
      border-radius: 12px;
    }
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
      margin-top: 16px;
    }
    .gallery-item {
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 14px;
      background: #fff;
      display: flex;
      flex-direction: column;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }
    .gallery-item img {
      width: 100%;
      height: 140px;
      object-fit: cover;
      background: #f8fafc;
      border-radius: 8px;
      border: 1px solid #e2e8f0;
    }

    /* All Rights Reserved & Signature Section Footer */
    .dashboard-footer {
      margin-top: 48px;
      border-top: 2px solid #e2e8f0;
      padding-top: 28px;
    }
    .footer-card {
      background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
      border: 1px solid #cbd5e1;
      border-radius: 16px;
      padding: 24px 28px;
      box-shadow: 0 4px 18px rgba(0, 34, 102, 0.04);
    }
    .footer-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 24px;
    }
    .footer-brand {
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .footer-logo {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--blue), var(--navy));
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 800;
      font-size: 16px;
      border: 2px solid var(--orange);
      box-shadow: 0 3px 10px rgba(0, 51, 153, 0.2);
    }
    .footer-brand h3 {
      font-family: Manrope, sans-serif;
      font-size: 16px;
      font-weight: 800;
      color: var(--navy);
      margin: 0;
    }
    .footer-brand p {
      font-size: 12px;
      color: var(--muted);
      margin: 2px 0 0;
    }
    .copyright-text {
      font-size: 12px;
      font-weight: 750;
      color: var(--blue) !important;
      margin-top: 6px !important;
    }
    .footer-signature-box {
      text-align: right;
      padding: 12px 18px;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }
    .signature-tag {
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--green);
      margin-bottom: 4px;
    }
    .footer-signature-img {
      height: 48px;
      max-width: 170px;
      object-fit: contain;
      filter: contrast(1.15);
      display: inline-block;
    }
    .signature-author {
      font-size: 12px;
      font-weight: 800;
      color: var(--navy);
      margin-top: 2px;
    }
    .signature-role {
      font-size: 11px;
      color: var(--muted);
    }
    .footer-bottom-bar {
      margin-top: 20px;
      padding-top: 14px;
      border-top: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      font-size: 11px;
      color: #64748b;
      font-weight: 600;
    }

    .hidden { display: none !important; }

    @media (max-width: 860px) {
      html, body {
        overflow-x: hidden !important;
        width: 100% !important;
        max-width: 100vw !important;
      }

      /* Responsive Topbar */
      .topbar {
        height: auto;
        min-height: 56px;
        padding: 10px 12px;
        flex-wrap: wrap;
        gap: 8px 12px;
        width: 100%;
        max-width: 100vw;
        box-sizing: border-box;
      }

      .brand {
        gap: 8px;
        flex: 1 1 auto;
      }

      .mark {
        width: 36px;
        height: 36px;
        font-size: 13px;
        flex-shrink: 0;
      }

      .brand-name {
        font-size: 14px;
        line-height: 1.2;
      }

      .brand-sub {
        display: none; /* Hide long subtitle on mobile so topbar stays compact */
      }

      .top-actions {
