<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | Umang Kakkad</title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{--blue:#2563eb;--blue-dark:#1d4ed8;--ink:#111827;--muted:#64748b;--line:#e5e7eb;--bg:#f8fafc;--red:#b91c1c;--green:#166534}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,Arial,sans-serif}
    button,input,textarea,select{font:inherit}button{cursor:pointer}
    .topbar{height:70px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:5}
    .brand{display:flex;align-items:center;gap:12px;font-weight:800}.mark{width:38px;height:38px;display:grid;place-items:center;background:var(--blue);color:white;border-radius:12px}
    .top-actions{display:flex;align-items:center;gap:12px}.muted{color:var(--muted);font-size:12px}
    .layout{display:grid;grid-template-columns:235px minmax(0,1fr);min-height:calc(100vh - 70px)}
    aside{background:#fff;border-right:1px solid var(--line);padding:24px 14px}
    .nav-label{font-size:10px;letter-spacing:1.2px;font-weight:800;color:#94a3b8;padding:0 12px;margin:8px 0 12px}
    .nav-btn{display:flex;width:100%;text-align:left;align-items:center;gap:11px;padding:12px;border:0;background:transparent;border-radius:10px;color:#475569;font-size:13px;font-weight:600;margin:3px 0}
    .nav-btn:hover,.nav-btn.active{background:#eff6ff;color:var(--blue)}
    main{padding:32px;min-width:0;max-width:1200px;width:100%;margin:0 auto}
    .page-head{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:24px}
    h1{font-size:27px;letter-spacing:-.8px;margin:0 0 8px}h2{font-size:17px;margin:0 0 8px}.sub{margin:0;color:var(--muted);font-size:13px;line-height:1.6}
    .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-bottom:20px}
    .card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:0 8px 25px rgba(15,23,42,.025);min-width:0}
    .metric{font-size:28px;font-weight:800;margin:10px 0 4px}.metric-label{font-size:12px;color:var(--muted)}
    .editor-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:18px}
    label{display:block;font-size:12px;font-weight:700;margin:14px 0 7px}
    input,textarea,select{width:100%;border:1px solid #cbd5e1;border-radius:10px;padding:12px;outline:none;background:#fff;color:var(--ink);font-size:13px}
    input:focus,textarea:focus,select:focus{border-color:var(--blue);box-shadow:0 0 0 3px #2563eb18}
    textarea{min-height:320px;resize:vertical;font-family:Consolas,Monaco,monospace;line-height:1.55;tab-size:2}
    .btn{border:0;border-radius:10px;padding:11px 15px;font-size:12px;font-weight:700;background:var(--blue);color:#fff}
    .btn:hover{background:var(--blue-dark)}.btn:disabled{opacity:.6;cursor:wait}
    .btn-secondary{background:#fff;color:#334155;border:1px solid var(--line)}.btn-secondary:hover{background:#f8fafc}
    .btn-danger{background:#fff;color:var(--red);border:1px solid #fecaca}.btn-danger:hover{background:#fef2f2}
    .actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}
    .notice{display:none;border-radius:10px;padding:12px 14px;font-size:12px;line-height:1.55;margin:16px 0 0;overflow-wrap:anywhere}
    .notice.show{display:block}.notice.error{background:#fef2f2;border:1px solid #fecaca;color:var(--red)}.notice.success{background:#f0fdf4;border:1px solid #bbf7d0;color:var(--green)}.notice.info{background:#eff6ff;border:1px solid #bfdbfe;color:#1d4ed8}
    .help{font-size:12px;color:var(--muted);line-height:1.7;margin-top:10px}
    .hidden{display:none!important}.status-pill{display:inline-block;border-radius:99px;padding:6px 9px;background:#f1f5f9;color:#475569;font-size:10px;font-weight:700}
    .footer{color:#94a3b8;font-size:11px;text-align:center;padding:22px}
    .record-list-note{padding:14px 16px;border:1px solid #cfe0ff;background:#f2f7ff;border-radius:12px;color:#1d4ed8;font-size:12px;line-height:1.6;margin-bottom:16px}.card[data-item]{border-left:3px solid #2563eb!important}.remove-item{white-space:nowrap}.actions .btn{min-height:42px}
    .gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px;margin-top:16px}
    .gallery-item{border:1px solid var(--line);border-radius:12px;padding:10px;min-width:0;background:#fff}
    .gallery-item img{width:100%;height:150px;object-fit:contain;background:#f8fafc;border-radius:8px}
    .gallery-name{font-size:12px;overflow-wrap:anywhere;margin:9px 0;color:var(--ink)}
    @media(max-width:800px){.layout{grid-template-columns:1fr}aside{border-right:0;border-bottom:1px solid var(--line);padding:10px;display:flex;gap:5px;overflow-x:auto}.nav-label{display:none}.nav-btn{white-space:nowrap;width:auto;margin:0}.grid{grid-template-columns:1fr}.topbar{padding:0 16px}.top-actions .muted{display:none}main{padding:20px 14px}.page-head{flex-direction:column}textarea{min-height:260px}}
  
    /* Premium portfolio-matched visual refresh */
    :root{--blue:#2563eb;--blue-dark:#1d4ed8;--ink:#111827;--muted:#667085;--line:#e6eaf0;--bg:#f7f9fc}
    body{background:#f7f9fc;font-family:Inter,Arial,sans-serif;color:#111827}
    .topbar{height:76px;padding:0 max(22px,calc((100vw - 1320px)/2));border-bottom:1px solid #e6eaf0;background:rgba(255,255,255,.96)}
    .brand{gap:12px;font-family:Manrope,Inter,sans-serif;letter-spacing:-.3px}
    .mark{width:42px;height:42px;border-radius:12px;background:#111827;box-shadow:none;font-family:Manrope,sans-serif;font-size:13px}
    .top-actions{gap:14px}
    .layout{grid-template-columns:245px minmax(0,1fr);min-height:calc(100vh - 76px)}
    aside{padding:28px 16px;background:#fff;border-right:1px solid #e6eaf0}
    .nav-label{letter-spacing:1.4px;font-size:9px;padding:0 13px;color:#98a2b3}
    .nav-btn{padding:13px 14px;border-radius:10px;font-size:12px;transition:background .15s ease,color .15s ease}
    .nav-btn.active{background:#eff4ff;color:#2563eb;box-shadow:inset 2px 0 #2563eb}
    main{max-width:1260px;padding:36px}
    h1,h2{font-family:Manrope,Inter,sans-serif}
    h1{font-size:29px;letter-spacing:-1px}
    .sub{line-height:1.75}
    .card{border-radius:16px;border-color:#e6eaf0;box-shadow:0 8px 28px rgba(16,24,40,.035);padding:24px}
    .grid{gap:18px}
    .metric{font-family:Manrope,Inter,sans-serif;font-size:30px;letter-spacing:-1px}
    .btn{border-radius:9px;padding:12px 16px;font-size:11px;transition:background .15s ease,border-color .15s ease}
    .btn-secondary{border-color:#e0e5ed}
    input,textarea,select{border-color:#d0d5dd;border-radius:9px}
    input:focus,textarea:focus,select:focus{border-color:#2563eb;box-shadow:0 0 0 3px #2563eb15}
    .status-pill{letter-spacing:.45px}
    .footer{padding:25px 8px;color:#98a2b3}
    @media(max-width:800px){.layout{grid-template-columns:1fr}.topbar{height:68px;padding:0 15px}.layout{min-height:calc(100vh - 68px)}aside{padding:10px;background:#fff}.nav-btn{padding:11px 12px}.nav-btn.active{box-shadow:none}main{padding:22px 14px}.card{padding:19px}}

    /* Modern admin UI refresh */
    :root{--blue:#2563eb;--blue-dark:#1d4ed8;--ink:#101828;--muted:#667085;--line:#e4e7ec;--bg:#f5f7fb}
    body{background:radial-gradient(circle at 85% 0%,#eaf1ff 0,transparent 30%),#f5f7fb;color:var(--ink)}
    .topbar{height:78px;padding:0 clamp(16px,4vw,56px);background:rgba(255,255,255,.92);backdrop-filter:blur(14px);box-shadow:0 1px 0 #e4e7ec}
    .brand{font-size:15px}.mark{background:linear-gradient(135deg,#111827,#344054);border-radius:14px;box-shadow:0 5px 14px #10182820}
    .layout{grid-template-columns:252px minmax(0,1fr);min-height:calc(100vh - 78px)}
    aside{padding:25px 14px;background:rgba(255,255,255,.94);border-right:1px solid #e4e7ec}
    .nav-label{margin:8px 12px 14px;color:#98a2b3;font-size:10px}
    .nav-btn{padding:13px 14px;margin:4px 0;border-radius:12px;color:#475467;font-size:12px;transition:all .18s ease}
    .nav-btn:hover{background:#f2f4f7;color:#344054;transform:translateX(2px)}
    .nav-btn.active{background:linear-gradient(90deg,#eff4ff,#f8faff);color:#1d4ed8;box-shadow:inset 3px 0 #2563eb;font-weight:800}
    main{max-width:1440px;padding:clamp(20px,3vw,42px);padding-bottom:110px}
    h1{font-size:clamp(25px,3vw,32px);letter-spacing:-1.1px;color:#101828}
    .sub{color:#667085}.card{border:1px solid #e4e7ec;border-radius:20px;padding:clamp(18px,2vw,28px);box-shadow:0 12px 36px #10182808;background:rgba(255,255,255,.96)}
    .grid{gap:16px}.grid .card{position:relative;overflow:hidden}.grid .card:before{content:"";position:absolute;left:0;top:0;width:100%;height:3px;background:linear-gradient(90deg,#2563eb,#93c5fd)}
    .metric{font-size:32px;color:#101828}.metric-label{font-weight:700;color:#667085}
    .page-head{align-items:center}.status-pill{padding:7px 11px;background:#eef4ff;color:#1d4ed8;border:1px solid #dbe7ff}
    input,textarea,select{border:1px solid #d0d5dd;border-radius:11px;padding:13px;background:#fff}
    label{color:#344054;font-size:12px;letter-spacing:.01em}
    .btn{min-height:42px;padding:12px 17px;border-radius:11px;background:linear-gradient(135deg,#2563eb,#1d4ed8);box-shadow:0 4px 10px #2563eb20;font-size:12px}
    .btn:hover{background:linear-gradient(135deg,#1d4ed8,#1e40af);transform:translateY(-1px)}
    .btn-secondary{background:#fff;color:#344054;border:1px solid #d0d5dd;box-shadow:none}.btn-secondary:hover{background:#f9fafb}
    .btn-danger{background:#fff;color:#b42318;border:1px solid #fecdca;box-shadow:none}.btn-danger:hover{background:#fef3f2}
    .actions{gap:10px}.editor-head{align-items:center}
    .notice{border-radius:12px;padding:14px 16px}
    .gallery-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:16px}
    .gallery-item{padding:12px;border:1px solid #e4e7ec;border-radius:16px;background:#fff;min-width:0}
    .gallery-item img{width:100%;height:150px;object-fit:contain;background:#f8fafc;border-radius:10px}
    .gallery-name{font-size:12px;font-weight:700;overflow-wrap:anywhere;margin-top:10px}
    .sticky-update-bar{position:fixed;z-index:20;left:252px;right:0;bottom:0;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px clamp(16px,3vw,42px);background:rgba(255,255,255,.94);backdrop-filter:blur(14px);border-top:1px solid #e4e7ec;box-shadow:0 -8px 30px #1018280b}
    .sticky-update-copy{font-size:12px;color:#667085;line-height:1.5}.sticky-update-copy strong{display:block;color:#101828;font-size:13px}
    #stickySaveBtn{min-width:190px;min-height:46px;font-size:13px}
    .footer{padding-bottom:26px}
    @media(max-width:800px){.topbar{height:68px;padding:0 14px}.layout{grid-template-columns:1fr;min-height:calc(100vh - 68px)}aside{display:flex;gap:5px;overflow-x:auto;padding:10px;border-right:0;border-bottom:1px solid #e4e7ec}.nav-label{display:none}.nav-btn{flex:0 0 auto;white-space:nowrap;width:auto;margin:0;padding:11px 12px}.nav-btn:hover{transform:none}main{padding:20px 14px 120px}.page-head{align-items:flex-start;flex-direction:column}.sticky-update-bar{left:0;padding:10px 13px}.sticky-update-copy{font-size:11px}#stickySaveBtn{min-width:145px;padding:11px 12px}.gallery-grid{grid-template-columns:repeat(auto-fill,minmax(135px,1fr))}}

    /* Premium visitor feedback and admin-reply interface */
    .feedback-card{margin:16px 0!important;padding:22px!important;border:1px solid #e4eaf3!important;border-left:4px solid #2563eb!important;border-radius:18px!important;background:linear-gradient(145deg,#fff 0%,#fbfdff 100%)!important;box-shadow:0 8px 24px rgba(16,24,40,.045)!important}
    .feedback-person{display:flex;align-items:center;gap:12px;min-width:0}
    .feedback-avatar{width:42px;height:42px;flex:0 0 42px;display:grid;place-items:center;border-radius:14px;background:#eff4ff;color:#1d4ed8;font-weight:800;font-size:14px}
    .feedback-meta{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:5px;color:#667085;font-size:11px}
    .feedback-review{margin:14px 0 0;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.8;font-size:13px;color:#344054}
    .feedback-reply{margin-top:17px;padding:15px;border:1px solid #dbe7ff;background:#f6f9ff;border-radius:14px}
    .feedback-reply-head{display:flex;align-items:center;gap:8px;margin-bottom:8px;font-size:12px;font-weight:800;color:#1d4ed8}
    .reply-text{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7;font-size:13px;color:#344054;margin:0}
    .reply-editor{margin-top:14px;padding:15px;border:1px dashed #b8caff;background:#f8faff;border-radius:14px}
    .reply-editor textarea{min-height:100px;resize:vertical;font-family:Inter,Arial,sans-serif;line-height:1.6}
    .feedback-card .actions{margin-top:15px}
    .feedback-card .btn{min-height:40px}
    .feedback-card .btn-reply{background:#eff4ff;color:#1d4ed8;border:1px solid #c7d7fe;box-shadow:none}
    .feedback-card .btn-reply:hover{background:#dbeafe}
    .feedback-card .btn-save-reply{background:linear-gradient(135deg,#2563eb,#1d4ed8)}
    @media(max-width:600px){.feedback-card{padding:16px!important}.feedback-person{align-items:flex-start}.feedback-card .actions .btn{flex:1}.feedback-reply,.reply-editor{padding:12px}}

    .review-export-panel{margin-top:22px;padding:20px;border:1px solid #dbe7ff;border-radius:18px;background:linear-gradient(120deg,#eff6ff,#fff);display:flex;align-items:center;justify-content:space-between;gap:18px;flex-wrap:wrap}
    .export-copy{display:flex;align-items:center;gap:13px}.export-icon{width:46px;height:46px;display:grid;place-items:center;background:#fff;color:#2563eb;border:1px solid #dbe7ff;border-radius:14px;font-size:25px}.export-copy h2{margin:0 0 5px}.export-actions{display:flex;gap:10px;flex-wrap:wrap}.export-actions .btn{min-height:44px}.review-export-panel .sub{max-width:520px}
    .feedback-card .export-review-pdf,.feedback-card .export-review-image{background:#fff;color:#1d4ed8;border:1px solid #d0dffb;box-shadow:none}
    @media(max-width:600px){.review-export-panel{padding:14px}.export-actions{width:100%}.export-actions .btn{flex:1}.export-copy{align-items:flex-start}}
    /* Cross-device review export controls */
    .export-actions .btn,.feedback-card .actions .btn{touch-action:manipulation;-webkit-tap-highlight-color:transparent}
    @media(max-width:600px){
      .review-export-panel .export-actions{display:grid;grid-template-columns:1fr;width:100%}
      .review-export-panel .export-actions .btn{width:100%;min-height:46px}
      .feedback-card .actions .btn{min-height:44px}
    }
  
    /* Final readability pass: visitor feedback, forms and footer */
    body, main, #feedbackPage { color:#172b4d !important; }
    #feedbackPage, #feedbackPage * { box-sizing:border-box; }
    #feedbackPage h1, #feedbackPage h2, #feedbackPage h3,
    #feedbackPage strong, #feedbackPage b, #feedbackPage label,
    #feedbackPage .review-name, #feedbackPage .feedback-name { color:#102b59 !important; }
    #feedbackPage p, #feedbackPage .sub, #feedbackPage small,
    #feedbackPage .review-text, #feedbackPage .feedback-review,
    #feedbackPage .review-meta, #feedbackPage .muted { color:#435574 !important; }
    #feedbackPage .card, #feedbackList .card, #feedbackList [class*="review"],
    #feedbackList [class*="feedback"] { color:#172b4d; }
    #feedbackList { color:#172b4d !important; font-size:14px; line-height:1.65; }
    #feedbackList p { color:#435574 !important; line-height:1.7; overflow-wrap:anywhere; }
    #feedbackList strong, #feedbackList b { color:#102b59 !important; }
    #feedbackList input, #feedbackList textarea, #feedbackList select,
    #feedbackPage input, #feedbackPage textarea, #feedbackPage select {
      width:100%; max-width:100%; color:#172b4d !important; background:#fff !important;
      border:1px solid #c8d5e8 !important; font:14px/1.5 Inter,Arial,sans-serif;
    }
    #feedbackList button, #feedbackPage button { min-height:38px; }
    #feedbackNotice { color:#17345f; font-size:13px; line-height:1.6; overflow-wrap:anywhere; }
    #feedbackNotice.info { background:#edf4ff !important; color:#17418a !important; }
    #feedbackNotice.success { background:#ecfdf3 !important; color:#067647 !important; }
    #feedbackNotice.error { background:#fff1f0 !important; color:#b42318 !important; }
    .footer { text-align:center; line-height:1.7; letter-spacing:.4px!important; font-size:11px!important; color:#435574!important; }
    .footer:after { content:'© 2026 Umang Kakkad. All rights reserved. · Portfolio content and settings'; display:block; margin-top:8px; color:#667995; font-size:11px; font-weight:500; letter-spacing:0; }
    @media(max-width:600px) {
      #feedbackPage .editor-head { align-items:flex-start; flex-wrap:wrap; gap:10px; }
      #feedbackPage .review-export-panel { padding:14px!important; }
      #feedbackPage .export-actions { display:flex; flex-wrap:wrap; gap:8px; }
      #feedbackPage .export-actions .btn { flex:1 1 145px; white-space:normal; }
      #feedbackList { font-size:13px; }
      .footer { padding:22px 12px!important; }
    }

    /* Final UI polish: readable typography, clear button contrast, and visible save bar */
    :root { --blue:#1646a0; --blue-dark:#103777; --orange:#f59e0b; --line:#d6e0ef; }
    html { font-size:16px; }
    body { font-family:Inter, "Segoe UI", Arial, sans-serif !important; font-size:14px !important; line-height:1.6 !important; color:#172b4d !important; background:#f4f7fb !important; }
    h1 { font-size:clamp(22px,2vw,28px) !important; line-height:1.25 !important; font-weight:750 !important; color:#102b59 !important; }
    h2 { font-size:18px !important; line-height:1.35 !important; font-weight:700 !important; color:#102b59 !important; }
    h3 { font-size:15px !important; color:#102b59 !important; }
    p, .sub, .help, label, .notice { font-size:13px !important; line-height:1.65 !important; }
    .sub, .help { color:#52627a !important; }
    .topbar { background:#fff !important; border-bottom:1px solid #dce5f1 !important; }
    aside { background:linear-gradient(180deg,#123b80,#0c2c63) !important; }
    .nav-btn { font-size:13px !important; font-weight:650 !important; color:#eef4ff !important; }
    .nav-btn.active, .nav-btn[aria-current="page"] { background:#fff !important; color:#123b80 !important; border-left:4px solid #f59e0b !important; }
    .card { background:#fff !important; border:1px solid #dce5f1 !important; border-radius:14px !important; box-shadow:0 5px 18px rgba(20,45,85,.055) !important; }
    .btn, button.btn { min-height:40px; padding:10px 15px !important; border-radius:9px !important; font-family:Inter,"Segoe UI",Arial,sans-serif !important; font-size:13px !important; font-weight:700 !important; line-height:1.35 !important; }
    .btn:not(.btn-secondary):not(.btn-danger):not(.btn-reply) { background:#1646a0 !important; color:#fff !important; border:1px solid #1646a0 !important; }
    .btn:not(.btn-secondary):not(.btn-danger):not(.btn-reply):hover { background:#103777 !important; color:#fff !important; }
    .btn-secondary, .feedback-card .btn-reply, .export-review-pdf, .export-review-image { background:#fff !important; color:#1646a0 !important; border:1px solid #b9cbed !important; box-shadow:none !important; }
    .btn-danger { background:#fff !important; color:#b42318 !important; border:1px solid #f1b7b2 !important; }
    /* Prevent dark-on-dark labels in the review reply and delete controls. */
    .feedback-card .btn-reply { background:#edf4ff !important; color:#1646a0 !important; }
    .feedback-card .btn-save-reply { background:#1646a0 !important; color:#fff !important; }
    .feedback-card .delete-feedback, .feedback-card .delete-feedback-reply { background:#fff !important; color:#b42318 !important; border:1px solid #f1b7b2 !important; }
    .feedback-card { padding:22px !important; border-left:4px solid #1646a0 !important; }
    .feedback-person h3, .feedback-person strong, .feedback-card strong { color:#102b59 !important; }
    .feedback-review, .reply-text { color:#334155 !important; font-size:14px !important; line-height:1.75 !important; }
    .feedback-meta { color:#52627a !important; font-size:12px !important; }
    .feedback-card .actions { display:flex; flex-wrap:wrap; gap:9px; }
    input, textarea, select { font-family:Inter,"Segoe UI",Arial,sans-serif !important; font-size:14px !important; color:#172b4d !important; }
    input::placeholder, textarea::placeholder { color:#77859a !important; opacity:1; }
    .sticky-update-bar { left:252px !important; background:#fff !important; border-top:2px solid #f59e0b !important; box-shadow:0 -8px 24px rgba(16,43,89,.12) !important; padding:12px clamp(16px,3vw,34px) !important; }
    .sticky-update-copy { color:#52627a !important; font-size:13px !important; line-height:1.5 !important; }
    .sticky-update-copy strong { color:#102b59 !important; font-size:15px !important; font-weight:750 !important; }
    #stickySaveBtn { min-width:210px !important; min-height:46px !important; background:#1646a0 !important; color:#fff !important; border:1px solid #1646a0 !important; font-size:14px !important; font-weight:750 !important; box-shadow:0 4px 12px rgba(22,70,160,.2) !important; }
    #stickySaveBtn:hover { background:#103777 !important; }
    .footer { padding:24px 12px 90px !important; color:#52627a !important; font-size:12px !important; line-height:1.7 !important; border-top:1px solid #dce5f1; background:#fff !important; }
    .footer:after { color:#52627a !important; font-size:12px !important; }
    #feedbackBadge, .status-pill { font-size:11px !important; font-weight:750 !important; }
    @media(max-width:800px) {
      .sticky-update-bar { left:0 !important; gap:10px !important; }
      .sticky-update-copy { font-size:12px !important; }
      .sticky-update-copy strong { font-size:13px !important; }
      #stickySaveBtn { min-width:155px !important; font-size:12px !important; }
      main { padding-bottom:130px !important; }
    }
    @media(max-width:520px) {
      .sticky-update-bar { align-items:stretch !important; flex-direction:column !important; }
      #stickySaveBtn { width:100% !important; }
      .feedback-card { padding:15px !important; }
      .feedback-card .actions .btn { flex:1 1 135px; }
    }
  </style>

  <style id="portfolio-matched-professional-theme">
    :root{--blue:#073b9a;--blue-dark:#062c76;--orange:#ff9800;--ink:#101828;--muted:#667085;--line:#dfe6f1;--bg:#f4f7fc;--green:#167647;--red:#b42318}
    html{scroll-behavior:smooth} body{background:linear-gradient(180deg,#eef4ff 0,#f7f9fd 260px,#f7f9fd 100%);color:var(--ink);font-family:Inter,Arial,sans-serif}
    .topbar{height:78px;background:#fff;border-bottom:3px solid var(--orange);box-shadow:0 5px 18px #082f7010;padding:0 clamp(16px,4vw,48px)}
    .brand{font-family:Inter,Arial,sans-serif;font-size:15px;font-weight:800;letter-spacing:.1px;color:#073b9a}
    .mark{width:44px;height:44px;border-radius:50%;background:#073b9a;border:2px solid var(--orange);box-shadow:0 3px 9px #073b9a20;font-size:13px}
    .top-actions{gap:12px}.top-actions .btn{white-space:nowrap}
    .layout{grid-template-columns:250px minmax(0,1fr);min-height:calc(100vh - 78px)}
    aside{background:#fff;border-right:1px solid #dfe6f1;padding:24px 14px;box-shadow:4px 0 16px #0b347008}
    .nav-label{color:#7a8ba8;letter-spacing:1.3px;font-size:10px}
    .nav-btn{border-radius:8px;color:#35445d;padding:12px 13px;font-weight:650;transition:all .16s ease}
    .nav-btn:hover{background:#edf3ff;color:#073b9a;transform:translateX(2px)}
    .nav-btn.active{background:#073b9a;color:#fff;box-shadow:inset 4px 0 var(--orange)}
    main{max-width:1480px;padding:clamp(20px,3vw,40px);padding-bottom:112px}
    h1,h2{font-family:Inter,Arial,sans-serif;color:#073b9a}h1{font-size:clamp(25px,3vw,32px);letter-spacing:-.7px;font-weight:800}h2{font-weight:750}
    .sub{color:#65748b;line-height:1.7}
    .page-head{padding-bottom:18px;border-bottom:1px solid #e2e9f4;margin-bottom:24px}
    .card{background:#fff;border:1px solid #dfe6f1;border-radius:14px;padding:clamp(18px,2vw,26px);box-shadow:0 8px 24px #0a2f7010}
    .grid{gap:16px}.grid .card{border-top:3px solid var(--orange);position:relative}
    .metric{font-size:32px;color:#073b9a;font-weight:800}.metric-label{font-weight:650;color:#64748b}
    input,textarea,select{border:1px solid #cbd6e6;border-radius:8px;background:#fff;color:#101828;padding:12px 13px}
    input:focus,textarea:focus,select:focus{border-color:#073b9a;box-shadow:0 0 0 3px #073b9a18}
    label{color:#273b5b;font-weight:750}
    .btn{background:#073b9a;color:#fff;border-radius:8px;box-shadow:0 3px 8px #073b9a20;font-weight:750;transition:transform .15s,background .15s}
    .btn:hover{background:#062c76;transform:translateY(-1px)}
    .btn-secondary{background:#fff;color:#073b9a;border:1px solid #b9c9e3;box-shadow:none}.btn-secondary:hover{background:#edf3ff}
    .btn-danger{background:#fff;color:#b42318;border:1px solid #f2c5c2;box-shadow:none}.btn-danger:hover{background:#fff1f0}
    .status-pill{background:#eaf1ff;color:#073b9a;border:1px solid #d0dfff;letter-spacing:.4px}
    .record-list-note{background:#edf4ff;border-color:#cbdcff;color:#073b9a}
    .card[data-item]{border-left:3px solid var(--orange)!important}
    .gallery-item{border:1px solid #dfe6f1;border-radius:12px;box-shadow:0 5px 16px #0a2f7008}
    .gallery-item img{background:#f4f7fc}
    .notice.info{background:#edf4ff;border-color:#cbdcff;color:#073b9a}
    .sticky-update-bar{border-top:2px solid var(--orange)!important;background:rgba(255,255,255,.97)!important;box-shadow:0 -8px 24px #0a2f7010!important;backdrop-filter:blur(12px)}
    .footer{color:#71809a;border-top:1px solid #e3eaf4;margin-top:24px}
    @media(max-width:800px){.topbar{height:auto;min-height:68px;padding:12px 14px;gap:10px;flex-wrap:wrap}.brand{font-size:13px}.mark{width:38px;height:38px}.layout{grid-template-columns:1fr;min-height:calc(100vh - 68px)}aside{padding:9px;background:#fff;border-bottom:2px solid var(--orange);box-shadow:none}.nav-btn{padding:10px 12px}.nav-btn.active{box-shadow:inset 0 -3px var(--orange)}main{padding:20px 13px 110px}.card{border-radius:12px}.page-head{align-items:flex-start}.sticky-update-bar{padding:10px!important;gap:8px!important}.sticky-update-copy span{font-size:11px}}
  </style>

  <style>
    /* Workspace + footer redesign: portfolio-matched navy / blue / orange */
    :root{--workspace-navy:#071f52;--workspace-blue:#073b9a;--workspace-orange:#ff9800;--workspace-pale:#eef4ff}
    body{background:#f3f6fb;color:#12213b}
    .topbar{background:linear-gradient(110deg,#fff 0%,#f8fbff 100%);border-bottom:3px solid var(--workspace-orange);box-shadow:0 8px 24px rgba(7,31,82,.07)}
    .brand{gap:13px;font-size:15px;color:var(--workspace-navy)}
    .mark{background:linear-gradient(145deg,var(--workspace-blue),var(--workspace-navy));border:2px solid #ffb02e;border-radius:50%;box-shadow:0 0 0 4px #073b9a12;font-size:14px}
    .layout{grid-template-columns:264px minmax(0,1fr);gap:0;background:#f3f6fb}
    aside{position:sticky;top:78px;align-self:start;height:calc(100vh - 78px);overflow-y:auto;display:flex;flex-direction:column;padding:20px 14px 18px;background:linear-gradient(180deg,#08265f 0%,#073b9a 70%,#062a70 100%);border:0;border-right:4px solid var(--workspace-orange);box-shadow:8px 0 26px rgba(7,31,82,.08)}
    .nav-label{color:#ffc766!important;font-size:10px!important;letter-spacing:2px!important;margin:4px 12px 14px!important;padding:0 0 13px!important;border-bottom:1px solid rgba(255,255,255,.2)}
    .nav-label:before{content:'▦';display:inline-grid;place-items:center;width:27px;height:27px;margin-right:9px;border-radius:8px;background:rgba(255,255,255,.13);color:#fff;font-size:15px;vertical-align:middle}
    .nav-btn{position:relative;color:#e6eeff!important;background:transparent!important;border:1px solid transparent!important;border-radius:11px!important;padding:12px 13px!important;margin:3px 0!important;font-size:12px!important;letter-spacing:.05px;transition:all .18s ease}
    .nav-btn:hover{background:rgba(255,255,255,.1)!important;border-color:rgba(255,255,255,.12)!important;transform:translateX(3px)}
    .nav-btn.active{background:#fff!important;color:#073b9a!important;border-color:#ffb02e!important;box-shadow:0 5px 16px rgba(0,0,0,.12),inset 4px 0 var(--workspace-orange)!important;font-weight:800}
    aside:after{content:'UMANG KAKKAD  •  ADMIN WORKSPACE';display:block;margin-top:auto;padding:19px 9px 3px;border-top:1px solid rgba(255,255,255,.2);color:#dce8ff;font-size:9px;font-weight:800;letter-spacing:1px;line-height:1.8}
    main{max-width:none;padding:clamp(20px,3vw,42px);padding-bottom:125px;background:radial-gradient(ellipse at 100% 0%,rgba(255,152,0,.07),transparent 25%),#f3f6fb}
    .page-head{padding:0 0 18px;border-bottom:1px solid #dce5f2;margin-bottom:24px}
    h1{color:var(--workspace-navy);letter-spacing:-.8px}
    .page-head h1:after{content:'';display:block;width:56px;height:4px;margin-top:10px;border-radius:5px;background:linear-gradient(90deg,var(--workspace-orange),#ffd17a)}
    .card{border:1px solid #dce5f2!important;border-radius:16px!important;background:#fff!important;box-shadow:0 10px 30px rgba(7,31,82,.055)!important}
    .grid .card:before{height:4px!important;background:linear-gradient(90deg,var(--workspace-blue),var(--workspace-orange))!important}
    .metric{color:var(--workspace-blue)!important}
    .status-pill{background:#edf4ff!important;color:var(--workspace-blue)!important;border-color:#cfdef9!important}
    .btn{background:linear-gradient(135deg,#073b9a,#08265f)!important;border:1px solid #073b9a!important;border-radius:9px!important;box-shadow:0 4px 12px rgba(7,59,154,.16)!important}
    .btn:hover{background:linear-gradient(135deg,#0a4ab8,#073b9a)!important}
    .btn-secondary{background:#fff!important;color:#073b9a!important;border:1px solid #c6d5ed!important;box-shadow:none!important}
    .btn-secondary:hover{background:#edf4ff!important}
    .sticky-update-bar{z-index:8!important;border-top:3px solid var(--workspace-orange)!important;background:rgba(255,255,255,.97)!important;box-shadow:0 -10px 30px rgba(7,31,82,.1)!important;padding:13px clamp(16px,3vw,40px)!important}
    .sticky-update-copy strong{color:var(--workspace-navy)}
    .sticky-update-copy span{color:#667995}
    .footer{position:relative;margin-top:38px!important;padding:26px 18px 22px!important;border:1px solid #dce5f2!important;border-top:4px solid var(--workspace-orange)!important;border-radius:14px!important;background:linear-gradient(120deg,#fff,#f4f8ff)!important;color:#526783!important;font-size:10px!important;font-weight:800;letter-spacing:1.1px;box-shadow:0 8px 22px rgba(7,31,82,.04)}
    .footer:before{content:'UK';display:grid;place-items:center;width:34px;height:34px;margin:0 auto 10px;border-radius:50%;background:var(--workspace-blue);border:2px solid var(--workspace-orange);color:#fff;font-size:11px;letter-spacing:0}
    .footer:after{content:'Manage your portfolio with confidence';display:block;margin-top:8px;color:#8796ac;font-size:10px;font-weight:500;letter-spacing:0}
    @media(max-width:800px){.layout{grid-template-columns:1fr}.layout aside{position:relative;top:auto;height:auto;display:flex;flex-direction:row;align-items:center;overflow-x:auto;overflow-y:hidden;padding:9px;background:linear-gradient(90deg,#08265f,#073b9a);border-right:0;border-bottom:3px solid var(--workspace-orange)}aside:after{display:none}.nav-label{display:none!important}.nav-btn{flex:0 0 auto;white-space:nowrap}.nav-btn:hover{transform:none}.nav-btn.active{box-shadow:inset 0 -3px var(--workspace-orange)!important}.page-head{align-items:flex-start}.footer{margin-top:24px!important}.sticky-update-bar{gap:10px!important}}
    @media(min-width:801px) and (max-width:1100px){.layout{grid-template-columns:225px minmax(0,1fr)}aside{padding:17px 10px}.nav-btn{font-size:11px!important;padding:11px!important}main{padding:22px}}
  </style>

<style id="faq-management-styles">
#faqPage textarea{min-height:150px}
.faq-admin-row{padding:17px 0;border-bottom:1px solid #e2e9f4}
.faq-admin-row:last-child{border-bottom:0}
.faq-admin-question{font-size:14px;font-weight:800;color:#073b9a;overflow-wrap:anywhere}
.faq-admin-answer{white-space:pre-wrap;overflow-wrap:anywhere;color:#52627a;font-size:13px;line-height:1.7;margin-top:8px}
.faq-admin-meta{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:9px}
.faq-admin-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.faq-admin-actions .btn{min-height:38px}
#faqPublished{accent-color:#073b9a}
@media(max-width:600px){#faqPage .grid{grid-template-columns:1fr!important}.faq-admin-actions .btn{flex:1}}
</style>

<style id="admin-signature-style">
    /* Signature branding: clean, responsive and embedded so no extra image file is needed. */
    .admin-signature-wrap{display:flex;justify-content:center;align-items:center;width:100%;margin:0 auto 12px;padding:2px 0}
    .admin-signature{display:block;width:min(360px,78vw);height:auto;max-height:112px;object-fit:contain;object-position:center;filter:drop-shadow(0 2px 1px rgba(7,31,82,.05))}
    .footer:before{content:none!important;display:none!important}
    .footer{padding-top:24px!important}
    @media(max-width:600px){.admin-signature{width:min(290px,78vw);max-height:88px}.admin-signature-wrap{margin-bottom:8px}}
</style>
</head>
<body>
  <header class="topbar">
    <div class="brand"><div class="mark">UK</div><div>Portfolio Admin<div class="muted" style="font-weight:500;margin-top:3px">Umang Kakkad</div></div></div>
    <div class="top-actions"><span id="adminEmail" class="muted">Checking admin session…</span><button id="logoutBtn" class="btn btn-secondary" type="button">Log out</button></div>
  </header>

  <div id="loadingScreen" style="max-width:650px;margin:70px auto;padding:24px;text-align:center">
    <h2>Verifying secure admin access…</h2><p class="sub">Please wait.</p><div id="loadingMessage" class="notice show info"></div>
  </div>

  <div id="app" class="layout hidden">
    <aside>
      <div class="nav-label">WORKSPACE</div>
      <button class="nav-btn active" data-section="overview">▦ Overview</button>
      <button class="nav-btn" data-section="about">👤 About Me</button>
      <button class="nav-btn" data-section="projects">▣ Projects</button>
      <button class="nav-btn" data-section="education">🎓 Academics</button>
      <button class="nav-btn" data-section="skills">🧠 Skills</button>
      <button class="nav-btn" data-section="experience">💼 Experience</button>
      <button class="nav-btn" data-section="certificates">🏆 Certificates</button>
      <button class="nav-btn" data-section="events">▧ Events & Gallery</button>
      <button class="nav-btn" data-section="resume">📄 Resume</button>
      <button class="nav-btn" data-section="notices">📣 Latest Updates</button>
      <button class="nav-btn" data-section="site_settings">⚙️ Site Settings</button>
      <button class="nav-btn" data-section="image_gallery">🖼️ Image Gallery</button>
      <button class="nav-btn" data-section="feedback">✉️ Visitor Feedback</button>
      <button class="nav-btn" data-section="faq">❓ FAQ Management</button>
    </aside>

    <main>
      <section id="overviewPage">
        <div class="page-head"><div><h1>Dashboard overview</h1><p class="sub">Your portfolio admin workspace.</p></div><span class="status-pill">ADMIN SESSION VERIFIED</span></div>
        <div class="grid">
          <div class="card"><div class="metric">✓</div><div class="metric-label">Authentication</div><p class="sub" style="margin-top:10px">Supabase login connected</p></div>
          <div class="card"><div class="metric" id="sectionCount">—</div><div class="metric-label">Saved content sections</div><p class="sub" style="margin-top:10px">Records in portfolio_content</p></div>
          <div class="card"><div class="metric">JSON</div><div class="metric-label">Content editor</div><p class="sub" style="margin-top:10px">Edit section data and save it</p></div>
          <div class="card"><div class="metric" id="totalViews">—</div><div class="metric-label">Total Page Views</div><p class="sub" style="margin-top:10px">All recorded page views</p></div>
          <div class="card"><div class="metric" id="todayViews">—</div><div class="metric-label">Today's Views</div><p class="sub" style="margin-top:10px">Page views since local midnight</p></div>
          <div class="card"><div class="metric" id="weekViews">—</div><div class="metric-label">Last 7 Days</div><p class="sub" style="margin-top:10px">Page views in the last 7 days</p></div>
          <div class="card"><div class="metric" id="feedbackCount">—</div><div class="metric-label">Visitor Feedback</div><p class="sub" style="margin-top:10px">Messages received from visitors</p></div>
        </div>
        <div class="card">
          <h2>Welcome to your admin dashboard</h2>
          <p class="sub">Choose a section from the left menu to load or edit its content. Your changes are saved to the Supabase database.</p>
          <div class="notice show info">This dashboard saves editable content to Supabase. Use “Import Existing Website Content” once to bring existing cards and images into the database; populated sections are preserved. Saving changes does not publish or commit files to GitHub.</div>
          <div class="actions"><button class="btn" id="goAboutBtn" type="button">Start with About Me</button><button class="btn btn-secondary" id="refreshOverviewBtn" type="button">Refresh overview</button><button class="btn btn-secondary" id="importWebsiteBtn" type="button">Import Existing Website Content</button></div><p class="help">One-time migration: reads existing cards and images from index.html and adds only missing/empty sections to Supabase. Existing populated database sections are preserved.</p>
        </div>
      </section>

      <section id="editorPage" class="hidden">
        <div class="page-head"><div><h1 id="editorTitle">Edit content</h1><p class="sub" id="editorSubtitle">Edit this section's JSON data.</p></div><button id="loadBtn" class="btn btn-secondary" type="button">Reload from database</button></div>
        <div class="card">
          <div class="editor-head"><div><h2 id="formHeading">Edit details</h2><p class="sub">Your saved details appear below. Edit any field, add a record, or mark a record for removal. Press Save / Update Changes to apply database changes.</p></div><span id="recordStatus" class="status-pill">NOT LOADED</span></div>
          <div id="formEditor"></div>
          <div class="help">Workflow: edit or add records → click <strong>Save / Update Changes</strong>. Removing a record from the form is not permanent until you save.</div>
          <p class="help">Images and files are uploaded to Supabase Storage. Make sure the Storage bucket configured for this dashboard exists.</p>
          <div class="actions"><button id="saveBtn" class="btn" type="button">Save / Update Changes</button><button id="addItemBtn" class="btn btn-secondary hidden" type="button">＋ Add New Record</button></div>
          <div id="editorNotice" class="notice" role="status" aria-live="polite"></div>
        </div>
      </section>
      <section id="galleryPage" class="hidden">
        <div class="page-head"><div><h1>Supabase Image Gallery</h1><p class="sub">Images stored in the portfolio-images bucket. Refresh to view newly uploaded files.</p></div><button id="refreshGalleryBtn" class="btn btn-secondary" type="button">Refresh images</button></div>
        <div class="card"><div id="galleryNotice" class="notice" role="status" aria-live="polite"></div><div id="storageGallery" class="gallery-grid"><p class="sub">Loading images…</p></div></div>
      </section>
      <section id="faqPage" class="hidden">
        <div class="page-head">
          <div><h1>FAQ Management</h1><p class="sub">Add, edit, publish, unpublish, and delete FAQs stored in Supabase.</p></div>
          <button id="refreshFaqBtn" class="btn btn-secondary" type="button">↻ Refresh FAQs</button>
        </div>
        <div class="card">
          <h2 id="faqFormTitle">Add a new FAQ</h2>
          <div id="faqNotice" class="notice" role="status" aria-live="polite"></div>
          <form id="faqForm">
            <input type="hidden" id="faqId">
            <label for="faqQuestion">Question</label>
            <input id="faqQuestion" maxlength="500" required placeholder="e.g. How can I contact you?">
            <label for="faqAnswer">Answer</label>
            <textarea id="faqAnswer" required maxlength="10000" style="min-height:150px;font-family:Inter,Arial,sans-serif" placeholder="Write a clear answer…"></textarea>
            <div class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr));margin-top:8px">
              <div><label for="faqCategory">Category</label><input id="faqCategory" maxlength="100" placeholder="General" value="General"></div>
              <div><label for="faqOrder">Display order</label><input id="faqOrder" type="number" min="0" step="1" value="0"></div>
            </div>
            <label style="display:flex;align-items:center;gap:10px;margin-top:16px"><input id="faqPublished" type="checkbox" style="width:18px;height:18px"> Publish this FAQ on the public website</label>
            <div class="actions"><button class="btn" id="saveFaqBtn" type="submit">Save FAQ</button><button class="btn btn-secondary" id="cancelFaqEditBtn" type="button">Clear form</button></div>
          </form>
        </div>
        <div class="card" style="margin-top:18px">
          <div class="editor-head"><div><h2>Saved FAQs</h2><p class="sub">Only published FAQs should appear on the public portfolio.</p></div><span id="faqCount" class="status-pill">LOADING</span></div>
          <label for="faqSearch">Search FAQs</label><input id="faqSearch" type="search" placeholder="Search by question, answer, or category…">
          <div id="faqList" style="margin-top:16px"><p class="sub">Loading FAQs…</p></div>
        </div>
      </section>
      <section id="feedbackPage" class="hidden">
        <div class="page-head"><div><h1>Visitor Feedback</h1><p class="sub">All messages visitors submitted through your portfolio feedback form, including star ratings.</p></div><button id="refreshFeedbackBtn" class="btn btn-secondary" type="button">↻ Refresh feedback</button></div>
        <div class="card"><div class="editor-head"><div><h2>All visitor reviews</h2><p class="sub">Only authenticated admins with database permission can read or delete these records.</p></div><span class="status-pill" id="feedbackBadge">LOADING</span></div><div id="feedbackNotice" class="notice" role="status" aria-live="polite"></div><div id="feedbackList"><p class="sub">Loading feedback…</p></div><div class="review-export-panel"><div class="export-copy"><div class="export-icon">✦</div><div><h2>Download All Reviews</h2><p class="sub">Save visitor reviews with the <strong>Umang Review Website Wishes</strong> design.</p></div></div><div class="export-actions"><button class="btn" id="downloadAllReviewsPdf" type="button">⇩ Download as PDF</button><button class="btn btn-secondary" id="downloadAllReviewsImage" type="button">▧ Download as Image</button></div></div></div>
      </section>
      <div id="globalNotice" class="notice" role="status" aria-live="polite"></div>
      <div class="footer"><div class="admin-signature-wrap"><img class="admin-signature" src="data:image/png;base64," alt="Umang Kakkad handwritten signature"></div>UMANG KAKKAD · PORTFOLIO ADMIN WORKSPACE</div>
    </main>
  </div>

  <div class="sticky-update-bar" aria-label="Save portfolio changes">
    <div class="sticky-update-copy"><strong>Portfolio changes</strong><span>Save or update the current section to Supabase. Public site reads the same database rows.</span></div>
    <button id="stickySaveBtn" class="btn" type="button">✓ Save / Update Changes</button>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
  <script>window.addEventListener("load",function(){if(!window.jspdf){var s=document.createElement("script");s.src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js";s.async=true;document.head.appendChild(s);}});</script>
  <script>
    const SUPABASE_URL = "https://rxbggmwzgbshmpjareav.supabase.co";
    const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_ptDO2uplwLjlJ2i-KCvkmA_1rcvyeGY";

    const sectionInfo = {
      about: { title: "About Me", subtitle: "Your introduction, bio, skills, and profile details.", starter: { title: "About Me", description: "Write your introduction here.", skills: [] } },
      projects: { title: "Projects", subtitle: "Your project portfolio data.", starter: [{ title: "Project title", description: "Project description", tech: [], link: "" }] },
      education: { title: "Academics", subtitle: "Edit education and academic journey cards.", starter: [{ title: "Degree / qualification", date: "", description: "Institution and details", image: "" }] },
      skills: { title: "Skills", subtitle: "Edit skills shown on the public portfolio.", starter: [{ title: "Skill category", date: "", description: "HTML, CSS, JavaScript" }] },
      experience: { title: "Experience", subtitle: "Edit internships and professional experience.", starter: [{ title: "Role / experience", date: "", description: "Company and responsibilities", image: "" }] },
      certificates: { title: "Certificates", subtitle: "Certificate names, dates, and image paths/URLs.", starter: [{ title: "Certificate name", date: "", image: "images/certificate.png" }] },
      events: { title: "Events & Gallery", subtitle: "Event details and photo paths/URLs.", starter: [{ title: "Event name", date: "", images: ["images/event-photo.png"] }] },
      resume: { title: "Resume", subtitle: "Resume link and display details.", starter: { title: "Resume", url: "files/resume.pdf" } },
      notices: { title: "Latest Updates", subtitle: "Add, edit, update, or delete each Latest Updates message.", starter: [{ text: "Portfolio updated — welcome to my portfolio." }] },
      site_settings: { title: "Site Settings", subtitle: "Edit the header, hero text, and theme colors to match your portfolio.", starter: { name: "Umang Kakkad", role: "Software Developer & MCA Student", university: "GLS University, Ahmedabad", heroTitle: "Welcome to the Official Portfolio of", heroDescription: "Building reliable desktop and web applications with modern technologies.", primaryColor: "#003399", accentColor: "#FF9900" } }
    };

    let client = null;
    let currentSection = "about";
    let currentUserId = null;
    let currentContent = null;
    let cachedFeedbackRows = [];
    let cachedReplyColumnsAvailable = false;
    const el = id => document.getElementById(id);
    const STORAGE_BUCKET = "portfolio-images"; 

    function notice(target, message, type = "info") { target.textContent = message; target.className = "notice show " + type; }
    function clearNotice(target) { target.textContent = ""; target.className = "notice"; }
    function setupClient() {
      if (!window.supabase) throw new Error("Supabase library failed to load. Check your internet connection and refresh.");
      if (!SUPABASE_URL || !SUPABASE_PUBLISHABLE_KEY || SUPABASE_URL.includes("PASTE_") || SUPABASE_PUBLISHABLE_KEY.includes("PASTE_") || !SUPABASE_URL.startsWith("https://") || !SUPABASE_URL.includes(".supabase.co") || SUPABASE_URL.includes("/rest/v1") || SUPABASE_URL.includes("/auth/v1")) throw new Error("Setup incomplete: add the same Supabase Project URL and Publishable Key used in login.html.");
      client = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, {auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
    }
    async function verifyAdmin() {
      setupClient();
      const {data:sessionData,error:sessionError}=await client.auth.getSession(); if(sessionError) throw sessionError;
      if(!sessionData.session){window.location.replace("login.html");return false;}
      const user=sessionData.session.user; currentUserId=user.id; el("adminEmail").textContent=user.email||"Admin";
      const {data:adminRow,error:adminError}=await client.from("portfolio_admins").select("user_id").eq("user_id",user.id).maybeSingle();
      if(adminError) throw new Error("Admin verification failed. Check portfolio_admins SELECT policy.");
      if(!adminRow){await client.auth.signOut();window.location.replace("login.html");return false;}
      el("loadingScreen").classList.add("hidden");el("app").classList.remove("hidden");await refreshOverview();return true;
    }

    async function importExistingWebsiteContent(){
      const button=el("importWebsiteBtn");
      if(!button)return;
      if(!confirm("Import existing cards and images from ../index.html into Supabase? Existing populated sections will be preserved; only missing or empty sections will be imported."))return;
      button.disabled=true;button.textContent="Importing…";
      let importStage="checking dashboard location";
      try{
        if(location.protocol==="file:")throw new Error("You opened dashboard.html directly from your computer (file://). Start Live Server or open the hosted GitHub Pages dashboard URL, then try again.");
        importStage="reading the portfolio index.html";
        const sourceURL=new URL("../index.html",window.location.href).href;
        const response=await fetch(sourceURL,{cache:"no-store"});
        if(!response.ok)throw new Error("Could not read "+sourceURL+" (HTTP "+response.status+"). Check that index.html is in the repository root and dashboard.html is inside the admin folder.");
        const html=await response.text();
        const doc=new DOMParser().parseFromString(html,"text/html");
        const absImage=img=>{
          if(!img)return "";
          const raw=img.getAttribute("src")||"";
          if(!raw)return "";
          try{return new URL(raw,sourceURL).href;}catch(_){return raw;}
        };
        const text=(node,selector)=>node.querySelector(selector)?.textContent?.trim()||"";
        const cards=selector=>[...doc.querySelectorAll(selector)];
        const paragraphs=card=>[...card.querySelectorAll("p")].map(p=>p.textContent.trim()).filter(Boolean);
        const mapped={};
        const about=doc.querySelector("#about");
        if(about){
          const bio=[...about.querySelectorAll('[class~="lg:col-span-2"] p')].map(p=>p.textContent.trim()).filter(Boolean);
          const headerName=text(doc,".header-identity h1")||text(doc,"#home .hero-content h1")||"Umang Kakkad";
          const headerPs=[...doc.querySelectorAll(".header-identity p")].map(p=>p.textContent.trim()).filter(Boolean);
          mapped.about={title:text(about,"h2")||"About Me",name:headerName,role:headerPs[0]||"Software Developer & MCA Student",university:headerPs[1]||"GLS University, Ahmedabad",description:bio.join("\n\n")||text(about,'[class~="lg:col-span-2"]'),skills:[],image:absImage(doc.querySelector("#profile-open-btn img.header-profile"))};
        }
        const extractCards=(selector,kind)=>{
          return cards(selector).map(card=>{
            const title=text(card,"h3")||text(card,"h2")||"";
            const ps=paragraphs(card);
            const imgs=[...card.querySelectorAll("img")].map(absImage).filter(Boolean);
            const item={title,description:ps.length?ps[ps.length-1]:"",date:ps.length>1?ps[0]:"",image:imgs[0]||""};
            if(kind==="projects"){
              const techNode=card.querySelector("p.text-xs, p[class*='text-xs'], .project-tech");
              item.tech=techNode?techNode.textContent.split(/[·,]/).map(x=>x.trim()).filter(Boolean):[];
              const link=card.querySelector("a[href]");
              item.link=link?new URL(link.getAttribute("href"),sourceURL).href:"";
            }
            if(kind==="events")item.images=imgs;
            if(kind==="certificates"){item.description="";item.image=imgs[0]||"";}
            return item;
          }).filter(item=>item.title||item.description||item.image||(item.images&&item.images.length));
        };
        mapped.projects=extractCards('#projects .grid > div',"projects");
        mapped.education=extractCards('#education .space-y-8 > div',"education");
        mapped.skills=extractCards('#skills .grid > div',"skills");
        mapped.experience=extractCards('#experience .grid > div',"experience");
        mapped.certificates=extractCards('#certificates .grid > div',"certificates");
        mapped.events=extractCards('#events [class~="lg:grid-cols-2"] > div',"events");
        const resumeLink=doc.querySelector('a[href*="resume-placeholder"],a[href*="resume.pdf"],a[href*="resume"]');
        if(resumeLink)mapped.resume={title:"Resume",url:new URL(resumeLink.getAttribute("href"),sourceURL).href};
        const ticker=text(doc,"#notice-marquee");
        if(ticker)mapped.notices=[{text:ticker}];
        mapped.site_settings={name:text(doc,".header-identity h1")||"Umang Kakkad",role:text(doc,".header-identity p"),university:text(doc,".header-identity p:last-child"),heroTitle:text(doc,"#home .hero-content h2"),heroDescription:text(doc,"#home .hero-content p"),primaryColor:"#003399",accentColor:"#FF9900"};

        importStage="connecting to Supabase and reading portfolio_content";
        const {data:existing,error:readError}=await client.from("portfolio_content").select("section,content");
        if(readError)throw new Error("Supabase read failed: "+readError.message+" (check internet connection and SELECT policy for the signed-in admin).");
        const existingBySection=Object.fromEntries((existing||[]).map(row=>[row.section,row.content]));
        const isEmpty=value=>value==null||(Array.isArray(value)&&value.length===0)||(typeof value==="object"&&!Array.isArray(value)&&Object.keys(value).length===0);
        const imported=[],preserved=[],skipped=[];
        for(const section of ["about","projects","education","skills","experience","certificates","events","resume","notices","site_settings"]){
          const value=mapped[section];
          if(value==null||(Array.isArray(value)&&value.length===0)){skipped.push(section);continue;}
          if(Object.prototype.hasOwnProperty.call(existingBySection,section)&&!isEmpty(existingBySection[section])){preserved.push(section);continue;}
          importStage="saving section "+section+" to Supabase";
          const {error}=await client.from("portfolio_content").upsert({section,content:value,updated_at:new Date().toISOString()},{onConflict:"section"});
          if(error)throw new Error("Could not import "+section+": "+error.message+" (check INSERT/UPDATE policy for the signed-in admin).");
          imported.push(section);
        }
        await refreshOverview();
        const details=[imported.length?"Imported: "+imported.join(", "):"No missing sections needed importing.",preserved.length?"Preserved existing database data: "+preserved.join(", "):"",skipped.length?"No matching static cards found for: "+skipped.join(", "):"","Refresh the public portfolio with Ctrl+F5 to verify."].filter(Boolean).join("\n");
        notice(el("globalNotice"),details,"success");
        alert("Website content import finished.\n\n"+details);
      }catch(error){
        const detail="Import failed while "+importStage+". "+(error.message||String(error));
        notice(el("globalNotice"),detail,"error");
        alert(detail);
      }finally{button.disabled=false;button.textContent="Import Existing Website Content";}
    }

    async function refreshOverview(){
      const {data,error}=await client.from("portfolio_content").select("section");
      if(error){el("sectionCount").textContent="—";notice(el("globalNotice"),"Could not read portfolio_content: "+error.message,"error");return;}
      el("sectionCount").textContent=String(new Set((data||[]).map(r=>r.section)).size);
      clearNotice(el("globalNotice"));
      await refreshVisitorStats();
      await refreshFeedbackCount();
    }

    async function refreshFeedbackCount(){
      try {
        const { count, error } = await client.from("visitor_feedback").select("id", { count: "exact", head: true });
        if (error) throw error;
        if (el("feedbackCount")) el("feedbackCount").textContent = String(count ?? 0);
      } catch (e) {
        if (el("feedbackCount")) el("feedbackCount").textContent = "—";
        console.warn("Feedback count could not load:", e.message || e);
      }
    }
    async function loadFeedback(){
      const host = el("feedbackList");
      host.innerHTML = '<p class="sub">Loading feedback…</p>';
      clearNotice(el("feedbackNotice"));
      el("feedbackBadge").textContent = "LOADING";
      try {
        let replyColumnsAvailable = true;
        let result = await client.from("visitor_feedback")
          .select("id,first_name,last_name,review,rating,created_at,admin_reply,admin_reply_at")
          .order("created_at", { ascending: false });
        if (result.error && /admin_reply|column .* does not exist|schema cache/i.test(result.error.message || "")) {
          replyColumnsAvailable = false;
          result = await client.from("visitor_feedback")
            .select("id,first_name,last_name,review,rating,created_at")
            .order("created_at", { ascending: false });
          if (result.error) throw result.error;
        } else if (result.error) {
          throw result.error;
        }
        const rows = result.data || [];
        cachedFeedbackRows = rows;
        cachedReplyColumnsAvailable = replyColumnsAvailable;
        el("feedbackBadge").textContent = `${rows.length} MESSAGE${rows.length === 1 ? "" : "S"}`;
        if (!rows.length) {
          host.innerHTML = '<div class="record-list-note">No feedback received yet. New submissions will appear here after the visitor form successfully saves to Supabase.</div>';
        } else {
          host.innerHTML = rows.map(row => {
            const fullName = [row.first_name, row.last_name].filter(Boolean).join(" ") || "Anonymous visitor";
            const initials = fullName.split(/\s+/).slice(0,2).map(part => part.charAt(0)).join("").toUpperCase();
            const rating = Math.max(0, Math.min(5, Number(row.rating) || 0));
            const replied = replyColumnsAvailable && Boolean((row.admin_reply || "").trim());
            return `<article class="card feedback-card" data-feedback-id="${Number(row.id)}">
              <div class="editor-head" style="margin-bottom:0;align-items:flex-start">
                <div class="feedback-person"><div class="feedback-avatar" aria-hidden="true">${escapeHtml(initials || "V")}</div><div style="min-width:0"><h2 style="overflow-wrap:anywhere;margin:0">${escapeHtml(fullName)}</h2><div class="feedback-meta"><span class="status-pill">${replied ? "REPLIED" : "AWAITING REPLY"}</span></div></div></div>
              </div>
              <p style="margin:14px 0 0;font-size:15px;color:#f59e0b;letter-spacing:2px" aria-label="Rating ${rating} out of 5">${"★".repeat(rating)}${"☆".repeat(5-rating)} <span style="font-size:12px;color:#475467;letter-spacing:0">(${rating}/5)</span></p>
              <p class="feedback-review">${escapeHtml(row.review || "")}</p>
              ${replied ? `<div class="feedback-reply"><div class="feedback-reply-head"><span>↩</span><span>Reply by Umang Kakkad</span></div><p class="reply-text">${escapeHtml(row.admin_reply)}</p></div>` : ""}
              <div class="reply-editor hidden" data-reply-editor><label for="reply-${Number(row.id)}">Reply as Umang Kakkad</label><textarea id="reply-${Number(row.id)}" data-reply-input placeholder="Write a friendly, professional reply…">${escapeHtml(row.admin_reply || "")}</textarea><div class="actions"><button class="btn btn-save-reply save-feedback-reply" type="button" data-id="${Number(row.id)}">Save Reply</button><button class="btn btn-secondary cancel-feedback-reply" type="button">Cancel</button></div>${!replyColumnsAvailable ? '<p class="help" style="color:#b42318">To save replies, first add the admin_reply columns in Supabase using the SQL shown below.</p>' : ''}</div>
              <div class="actions"><button class="btn btn-reply open-feedback-reply" type="button">${replied ? "✎ Edit Reply" : "↩ Reply as Umang Kakkad"}</button>${replied && replyColumnsAvailable ? `<button class="btn btn-secondary delete-feedback-reply" type="button" data-id="${Number(row.id)}">Delete Reply</button>` : ""}<button class="btn btn-secondary export-review-pdf" type="button" data-id="${Number(row.id)}">⇩ Download PDF</button><button class="btn btn-secondary export-review-image" type="button" data-id="${Number(row.id)}">▧ Download Image</button><button class="btn btn-danger delete-feedback" type="button" data-id="${Number(row.id)}">Delete Feedback</button></div>
            </article>`;
          }).join("");

          host.querySelectorAll(".open-feedback-reply").forEach(button => button.addEventListener("click", () => {
            const card = button.closest("[data-feedback-id]");
            const editor = card.querySelector("[data-reply-editor]");
            editor.classList.toggle("hidden");
            if (!editor.classList.contains("hidden")) editor.querySelector("textarea").focus();
          }));
          host.querySelectorAll(".cancel-feedback-reply").forEach(button => button.addEventListener("click", () => button.closest("[data-reply-editor]").classList.add("hidden")));
          host.querySelectorAll(".save-feedback-reply").forEach(button => button.addEventListener("click", async () => {
            const card = button.closest("[data-feedback-id]");
            const input = card.querySelector("[data-reply-input]");
            const reply = input.value.trim();
            if (!reply) { notice(el("feedbackNotice"), "Please write a reply before saving.", "error"); input.focus(); return; }
            button.disabled = true; button.textContent = "Saving…";
            try {
              const { error } = await client.from("visitor_feedback").update({admin_reply: reply, admin_reply_at: new Date().toISOString()}).eq("id", Number(button.dataset.id));
              if (error) throw error;
              await loadFeedback();
              notice(el("feedbackNotice"), "Reply saved successfully as Umang Kakkad.", "success");
            } catch (e) {
              notice(el("feedbackNotice"), "Could not save reply: " + (e.message || "Check the visitor_feedback UPDATE policy and reply columns."), "error");
              button.disabled = false; button.textContent = "Save Reply";
            }
          }));
          host.querySelectorAll(".delete-feedback-reply").forEach(button => button.addEventListener("click", async () => {
            if (!confirm("Delete your reply to this review? The visitor feedback will remain.")) return;
            button.disabled = true;
            try {
              const { error } = await client.from("visitor_feedback").update({admin_reply: null, admin_reply_at: null}).eq("id", Number(button.dataset.id));
              if (error) throw error;
              await loadFeedback();
              notice(el("feedbackNotice"), "Your reply was deleted. The visitor review is unchanged.", "success");
            } catch (e) {
              notice(el("feedbackNotice"), "Could not delete reply: " + (e.message || "Check the visitor_feedback UPDATE policy."), "error");
              button.disabled = false;
            }
          }));
          host.querySelectorAll(".delete-feedback").forEach(button => button.addEventListener("click", async () => {
            if (!confirm("Permanently delete this visitor feedback? This cannot be undone.")) return;
            button.disabled = true;
            try {
              const { error } = await client.from("visitor_feedback").delete().eq("id", Number(button.dataset.id));
              if (error) throw error;
              await loadFeedback(); await refreshFeedbackCount();
              notice(el("feedbackNotice"), "Feedback deleted successfully.", "success");
            } catch (e) {
              notice(el("feedbackNotice"), "Could not delete feedback: " + (e.message || "Check the visitor_feedback DELETE policy."), "error");
              button.disabled = false;
            }
          }));
          host.querySelectorAll(".export-review-pdf").forEach(button => button.addEventListener("click", () => exportReviewsPdf(cachedFeedbackRows.filter(r => Number(r.id) === Number(button.dataset.id)), true)));
          host.querySelectorAll(".export-review-image").forEach(button => button.addEventListener("click", () => exportReviewsImage(cachedFeedbackRows.filter(r => Number(r.id) === Number(button.dataset.id)), true)));
        }
        if (!replyColumnsAvailable) {
          notice(el("feedbackNotice"), "All visitor reviews are shown. To enable replies, run the one-time SQL in Supabase: ALTER TABLE public.visitor_feedback ADD COLUMN IF NOT EXISTS admin_reply TEXT, ADD COLUMN IF NOT EXISTS admin_reply_at TIMESTAMPTZ; Then refresh feedback.", "info");
        }
        await refreshFeedbackCount();
      } catch (e) {
        host.innerHTML = "";
        el("feedbackBadge").textContent = "ERROR";
        notice(el("feedbackNotice"), "Could not load feedback: " + (e.message || "Check the visitor_feedback SELECT policy, admin mapping, and admin_reply columns."), "error");
      }
    }
    function safeFilePart(value){return String(value||"Umang-Review").normalize("NFKD").replace(/[^a-zA-Z0-9-_]+/g,"-").replace(/^-+|-+$/g,"").slice(0,50)||"Umang-Review";}
    function reviewExportName(row){return [row.first_name,row.last_name].filter(Boolean).join(" ")||"Visitor";}
    function isAppleMobileBrowser(){
      return /iPhone|iPad|iPod/i.test(navigator.userAgent) ||
        (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
    }
    function isMobileBrowser(){ return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1); }
    
    // Adjusted File blob delivery function 
    async function deliverExportBlob(blob, filename){
      if(!blob || !blob.size) throw new Error("The file is empty. Please try again.");
      const isPdf = filename.toLowerCase().endsWith(".pdf");
      const mime = isPdf ? "application/pdf" : "image/png";
      const file = new File([blob], filename, {type:mime});
      const noticeBox = el("feedbackNotice");

      if(isMobileBrowser() && navigator.share && navigator.canShare){
        try {
          if(navigator.canShare({files:[file]})){
            await navigator.share({files:[file], title:filename});
            noticeBox.className = "notice show success";
            noticeBox.textContent = "Choose Save to Files, Save Image, or an available download destination in the share menu.";
            return "shared";
          }
        } catch(err) {
          if(err && err.name === "AbortError") {
            noticeBox.className = "notice show info";
            noticeBox.textContent = "Share was cancelled. Use the download link below if it is shown.";
          }
        }
      }

      const url = URL.createObjectURL(new Blob([blob], {type:mime}));
      noticeBox.className = "notice show info";
      noticeBox.innerHTML = "<strong>File ready.</strong> If the automatic download does not start, tap the download button below.";
      const link = document.createElement("a");
      link.href = url;
      link.download = filename;
      link.rel = "noopener";
      link.textContent = "⬇ Download " + (isPdf ? "PDF" : "PNG Image");
      link.style.cssText = "display:inline-flex;align-items:center;justify-content:center;margin:10px 8px 10px 0;padding:12px 18px;border-radius:8px;background:#123b83;color:#fff;font-weight:700;text-decoration:none;min-height:44px;";
      noticeBox.appendChild(document.createElement("br"));
      noticeBox.appendChild(link);

      if(!isAppleMobileBrowser()) {
        try { link.click(); } catch (_) { }
      } else {
        const openLink = document.createElement("a");
        openLink.href = url;
        openLink.target = "_blank";
        openLink.rel = "noopener";
        openLink.textContent = "Open file to Save/Share";
        openLink.style.cssText = "display:inline-flex;margin:10px 0;padding:12px 18px;border:1px solid #2563eb;border-radius:8px;color:#1d4ed8;font-weight:700;text-decoration:none;min-height:44px;align-items:center;";
        noticeBox.appendChild(openLink);
      }
      setTimeout(()=>URL.revokeObjectURL(url), 30*60*1000);
      return "download-requested";
    }

    function exportReviewsPdf(rows, single=false){
      if(!rows || !rows.length){
        notice(el("feedbackNotice"),"No reviews available to export yet.","info");
        return;
      }
      if(!window.jspdf || !window.jspdf.jsPDF){
        notice(el("feedbackNotice"),"The PDF library did not load. Refresh the dashboard and try again.","error");
        return;
      }
      try {
        const {jsPDF}=window.jspdf;
        const doc=new jsPDF({unit:"pt",format:"a4",compress:true});
        const pageW=doc.internal.pageSize.getWidth();
        const pageH=doc.internal.pageSize.getHeight();
        const margin=42, contentW=pageW-margin*2;
        const navy=[7,31,82], blue=[7,59,154], orange=[255,152,0];
        const muted=[91,107,132], textColor=[39,55,80], border=[220,230,244];
        const bottomLimit=pageH-132;
        const safeText=value=>String(value??"")
          .replace(/[“”]/g,'"').replace(/[‘’]/g,"'").replace(/[–—]/g,"-")
          .replace(/…/g,"...").replace(/©/g,"(c)")
          .replace(/[\u{1F000}-\u{1FAFF}\u{2600}-\u{27BF}]/gu,"")
          .replace(/[^\x09\x0A\x0D\x20-\xFF]/g,"").trim();
        const ratings=rows.map(r=>Math.max(0,Math.min(5,Number(r.rating)||0)));
        const average=ratings.length?(ratings.reduce((a,b)=>a+b,0)/ratings.length).toFixed(1):"0.0";
        const title=single?"VISITOR REVIEW":"VISITOR REVIEWS & WISHES";

        function header(pageNo){
          doc.setFillColor(7,31,82);doc.rect(0,0,pageW,104,"F");
          doc.setFillColor(...orange);doc.rect(0,101,pageW,3,"F");
          doc.setFillColor(255,255,255);doc.roundedRect(margin,22,43,43,10,10,"F");
          doc.setTextColor(...blue);doc.setFont("helvetica","bold");doc.setFontSize(13);
          doc.text("UK",margin+21.5,48,{align:"center"});
          doc.setTextColor(255,255,255);doc.setFont("helvetica","bold");doc.setFontSize(single?17:18);
          doc.text("UMANG KAKKAD",margin+56,37);
          doc.setFont("helvetica","normal");doc.setFontSize(9);
          doc.text(title,margin+56,54);
          doc.setTextColor(220,232,255);doc.setFontSize(8);
          doc.text("Software Developer | Portfolio Reviews and Ratings",margin+56,70);
          doc.setTextColor(255,255,255);doc.setFontSize(8);
          doc.text(`Average rating: ${average}/5     Total reviews: ${rows.length}`,margin+56,86);
          // Centered signature and ownership footer on every PDF page.
          doc.setDrawColor(...border); doc.setLineWidth(.8); doc.line(margin,pageH-126,pageW-margin,pageH-126);
          try { doc.addImage("data:image/png;base64,","PNG",(pageW-78)/2,pageH-119,78,30,undefined,"FAST"); }
          catch(signatureError) { console.warn("Signature image could not be embedded:",signatureError); }
          doc.setTextColor(...blue); doc.setFont("helvetica","bold"); doc.setFontSize(8);
          doc.text("OWNED · DESIGNED · DEVELOPED BY",pageW/2,pageH-81,{align:"center"});
          doc.setTextColor(...navy); doc.setFontSize(8.5);
          doc.text("UMANG KAKKAD",pageW/2,pageH-67,{align:"center"});
          doc.setTextColor(...muted); doc.setFont("helvetica","normal"); doc.setFontSize(7.5);
          doc.text("© 2026 Umang Kakkad. All Rights Reserved.",pageW/2,pageH-52,{align:"center"});
          doc.setFontSize(7); doc.text(`Page ${pageNo}`,pageW-margin,pageH-35,{align:"right"});
          // Copyright is displayed once in the centered signature footer above.
        }
        function newPage(){doc.addPage();header(doc.getNumberOfPages());return 126;}
        header(1);
        let y=126;
        rows.forEach((row,index)=>{
          const name=safeText(reviewExportName(row))||"Visitor";
          const rating=Math.max(0,Math.min(5,Number(row.rating)||0));
          const review=safeText(row.review)||"No written review provided.";
          const reply=safeText(row.admin_reply||"");
          const innerX=margin+18, innerW=contentW-36;
          doc.setFont("helvetica","normal");doc.setFontSize(10.5);
          const reviewLines=doc.splitTextToSize(review,innerW);
          doc.setFont("helvetica","normal");doc.setFontSize(9.5);
          const replyLines=reply?doc.splitTextToSize(reply,innerW):[];
          doc.setFont("helvetica","bold");doc.setFontSize(13);
          const nameLines=doc.splitTextToSize(name,innerW-90);
          const fixedH=83+(nameLines.length-1)*15+(replyLines.length?25:0);
          const availableLines=Math.max(3,Math.floor((bottomLimit-y-fixedH)/14));
          const estimatedH=fixedH+reviewLines.length*14+replyLines.length*13;
          if(y+Math.min(estimatedH,120)>bottomLimit){y=newPage();}
          // Keep a complete short review together; split exceptionally long messages cleanly across pages.
          let reviewIndex=0, replyIndex=0, firstPart=true;
          while(reviewIndex<reviewLines.length || replyIndex<replyLines.length || firstPart){
            const top=y;
            const maxLines=Math.max(3,Math.floor((bottomLimit-top-100)/14));
            const reviewPart=reviewLines.slice(reviewIndex,reviewIndex+maxLines);
            reviewIndex+=reviewPart.length;
            let replyPart=[];
            if(reviewIndex>=reviewLines.length && replyIndex<replyLines.length){
              const room=Math.max(2,Math.floor((bottomLimit-top-105-reviewPart.length*14)/13));
              replyPart=replyLines.slice(replyIndex,replyIndex+room);replyIndex+=replyPart.length;
            }
            const nameH=firstPart?Math.max(1,nameLines.length)*15:15;
            const cardH=Math.min(bottomLimit-top,Math.max(112,24+nameH+22+22+reviewPart.length*14+(replyPart.length?24+replyPart.length*13:0)+15));
            doc.setFillColor(255,255,255);doc.setDrawColor(...border);doc.setLineWidth(.8);
            doc.roundedRect(margin,top,contentW,cardH,9,9,"FD");
            doc.setFillColor(...orange);doc.roundedRect(margin,top,5,cardH,2,2,"F");
            let ty=top+24;
            doc.setFont("helvetica","bold");doc.setFontSize(13);doc.setTextColor(...navy);
            doc.text(firstPart?name+"":name+" (continued)",innerX,ty,{maxWidth:innerW-90});
            doc.setFont("helvetica","bold");doc.setFontSize(9);doc.setTextColor(190,112,0);
            doc.text(`${rating}/5  ${"* ".repeat(rating).trim()}`,margin+contentW-18,top+24,{align:"right"});
            ty+=nameH+5;
            doc.setFont("helvetica","bold");doc.setFontSize(8);doc.setTextColor(...blue);
            doc.text(firstPart?"VISITOR MESSAGE":"VISITOR MESSAGE (CONTINUED)",innerX,ty);ty+=14;
            doc.setFont("helvetica","normal");doc.setFontSize(10.5);doc.setTextColor(...textColor);
            reviewPart.forEach(line=>{if(ty<top+cardH-10){doc.text(line,innerX,ty);ty+=14;}});
            if(replyPart.length){
              ty+=4;doc.setFont("helvetica","bold");doc.setFontSize(8);doc.setTextColor(...blue);
              doc.text("REPLY BY UMANG KAKKAD",innerX,ty);ty+=13;
              doc.setFont("helvetica","normal");doc.setFontSize(9.5);doc.setTextColor(...textColor);
              replyPart.forEach(line=>{if(ty<top+cardH-8){doc.text(line,innerX,ty);ty+=13;}});
            }
            y=top+cardH+14;firstPart=false;
            if(reviewIndex<reviewLines.length || replyIndex<replyLines.length){y=newPage();}
          }
          if(index<rows.length-1 && y+105>bottomLimit)y=newPage();
        });
        const filename=single?`${safeFilePart(reviewExportName(rows[0]))}-Umang-Review.pdf`:"Umang-Review-Website-Wishes-All-Reviews.pdf";
        const blob=doc.output("blob");
        if(!blob||blob.size<100)throw new Error("The generated PDF is empty.");
        // Show a persistent fallback link as well as requesting the browser's native save.
        const box=el("feedbackNotice");
        box.className="notice show info";
        box.textContent="Your review PDF is ready with Umang Kakkad signature and copyright. If it does not download automatically, tap Download PDF below.";
        const url=URL.createObjectURL(blob);
        const link=document.createElement("a");
        link.href=url;link.download=filename;link.textContent="⬇ Download PDF";link.rel="noopener";
        link.style.cssText="display:inline-flex;align-items:center;justify-content:center;margin:10px 8px 2px 0;padding:12px 18px;border-radius:9px;background:#073b9a;color:#fff;font-weight:700;text-decoration:none;min-height:44px;";
        box.appendChild(document.createElement("br"));box.appendChild(link);
        try{doc.save(filename);}catch(saveError){/* Manual link remains available. */}
        setTimeout(()=>URL.revokeObjectURL(url),30*60*1000);
      } catch(error){
        notice(el("feedbackNotice"),"Could not create the review PDF: "+(error.message||"Refresh the dashboard and try again."),"error");
      }
    }

    async function exportReviewsImage(rows, single=false){
      if(!rows||!rows.length){notice(el("feedbackNotice"),"No reviews available to export yet.","info");return;}
      const width=1200,pad=64,scale=2,gap=24,cardW=width-pad*2;
      const measureCanvas=document.createElement("canvas"),mctx=measureCanvas.getContext("2d");
      const wrapLines=(ctx,text,maxWidth,font)=>{ctx.font=font;const words=String(text||"").split(/\s+/);const lines=[];let line="";for(const word of words){const test=line?line+" "+word:word;if(ctx.measureText(test).width>maxWidth&&line){lines.push(line);line=word;}else line=test;}if(line)lines.push(line);return lines;};
      const prepared=rows.map(row=>{const reviewLines=wrapLines(mctx,row.review||"No written review provided.",cardW-72,"18px Arial");const replyLines=String(row.admin_reply||"").trim()?wrapLines(mctx,row.admin_reply,cardW-72,"17px Arial"):[];const height=148+reviewLines.length*28+(replyLines.length?60+replyLines.length*26:0);return {row,reviewLines,replyLines,height:Math.max(190,height)};});
      const headerH=270,footerH=165,height=headerH+prepared.reduce((sum,item)=>sum+item.height+gap,0)+footerH;
      const safeScale=Math.max(0.5,Math.min(scale,14000/height,8192/width));
      const canvas=document.createElement("canvas");canvas.width=Math.round(width*safeScale);canvas.height=Math.round(height*safeScale);
      const ctx=canvas.getContext("2d");
      if(!ctx){notice(el("feedbackNotice"),"Your browser could not create the image. Try downloading the PDF instead.","error");return;}
      ctx.scale(safeScale,safeScale);
      const signatureImage = await new Promise((resolve) => {
        const image = new Image(); image.onload = () => resolve(image); image.onerror = () => resolve(null);
        image.src = "data:image/png;base64,";
      });
      const bg=ctx.createLinearGradient(0,0,width,height);bg.addColorStop(0,"#eef4ff");bg.addColorStop(1,"#ffffff");ctx.fillStyle=bg;ctx.fillRect(0,0,width,height);
      ctx.fillStyle="#111827";roundRect(ctx,pad,42,62,62,18);ctx.fill();ctx.fillStyle="#fff";ctx.font="bold 22px Arial";ctx.textAlign="center";ctx.fillText("UK",pad+31,81);
      ctx.textAlign="left";ctx.fillStyle="#111827";ctx.font="bold 34px Arial";ctx.fillText(single?"Visitor Review":"Umang Kakkad - Visitor Reviews",pad+82,74);
      ctx.fillStyle="#64748b";ctx.font="18px Arial";ctx.fillText("Software Developer | Portfolio Reviews and Ratings",pad+82,108);
      ctx.fillStyle="#2563eb";ctx.font="15px Arial";ctx.fillText("GitHub: github.com/kakkadumang",pad+82,132);
      ctx.font="15px Arial";ctx.fillStyle="#475467";
      const intro=single?"A visitor's kind words and wishes shared on Umang Kakkad's portfolio.":"A collection of visitor reviews, ratings, and wishes shared on Umang Kakkad's portfolio website.";
      wrapCanvasText(ctx,intro,pad+82,158,width-pad-(pad+82),21);
      const imageRatings=rows.map(r=>Math.max(0,Math.min(5,Number(r.rating)||0)));
      const imageAverage=imageRatings.length?(imageRatings.reduce((a,b)=>a+b,0)/imageRatings.length).toFixed(1):"0.0";
      ctx.fillStyle="#b45309";ctx.font="bold 17px Arial";ctx.fillText(`Overall rating: ${imageAverage}/5  |  Total reviews: ${rows.length}`,pad,184);
      ctx.strokeStyle="#dbe7ff";ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(pad,205);ctx.lineTo(width-pad,205);ctx.stroke();
      let y=headerH;
      prepared.forEach(({row,reviewLines,replyLines,height:h})=>{
        ctx.shadowColor="rgba(15,23,42,.08)";ctx.shadowBlur=16;ctx.shadowOffsetY=4;ctx.fillStyle="#fff";roundRect(ctx,pad,y,cardW,h,18);ctx.fill();ctx.shadowColor="transparent";
        ctx.fillStyle="#2563eb";roundRect(ctx,pad,y,7,h,4);ctx.fill();
        const name=reviewExportName(row),rating=Math.max(0,Math.min(5,Number(row.rating)||0));
        ctx.fillStyle="#111827";ctx.font="bold 24px Arial";ctx.textAlign="left";ctx.fillText(name,pad+28,y+39);
        ctx.fillStyle="#f59e0b";ctx.font="bold 25px Arial";ctx.fillText("★".repeat(rating)+"☆".repeat(5-rating),pad+28,y+75);
        ctx.fillStyle="#64748b";ctx.font="15px Arial";ctx.fillText(`(${rating}/5)`,pad+200,y+74);
        let ty=y+111;ctx.fillStyle="#1d4ed8";ctx.font="bold 14px Arial";ctx.fillText("VISITOR MESSAGE",pad+28,ty);ty+=28;
        ctx.fillStyle="#344054";ctx.font="18px Arial";reviewLines.forEach(line=>{ctx.fillText(line,pad+28,ty);ty+=28;});
        if(replyLines.length){ty+=10;ctx.fillStyle="#1d4ed8";ctx.font="bold 14px Arial";ctx.fillText("REPLY BY UMANG KAKKAD",pad+28,ty);ty+=27;ctx.fillStyle="#344054";ctx.font="17px Arial";replyLines.forEach(line=>{ctx.fillText(line,pad+28,ty);ty+=26;});}
        y+=h+gap;
      });
      const fy=height-footerH+8;ctx.strokeStyle="#dbe7ff";ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(pad,fy);ctx.lineTo(width-pad,fy);ctx.stroke();
      if(signatureImage) ctx.drawImage(signatureImage,(width-190)/2,fy+8,190,55);
      ctx.textAlign="center";ctx.fillStyle="#073b9a";ctx.font="bold 16px Arial";ctx.fillText("OWNED · DESIGNED · DEVELOPED BY",width/2,fy+82);
      ctx.fillStyle="#64748b";ctx.font="bold 16px Arial";ctx.fillText("UMANG KAKKAD",width/2,fy+106);
      ctx.font="14px Arial";ctx.fillStyle="#526783";ctx.fillText("© 2026 Umang Kakkad. All Rights Reserved.",width/2,fy+145);
      ctx.save();ctx.strokeStyle="#2563eb";ctx.lineWidth=5;ctx.strokeRect(8,8,width-16,height-16);ctx.restore();
      let blob;
      try {
        blob = await new Promise(resolve => canvas.toBlob(resolve, "image/png"));
      } catch (error) {
        notice(el("feedbackNotice"),"Your browser could not create the image. Try downloading the PDF instead.","error");
        return;
      }
      if(!blob){notice(el("feedbackNotice"),"Could not create the review image. Please try downloading the PDF instead.","error");return;}
      const filename = single
        ? `${safeFilePart(reviewExportName(rows[0]))}-Umang-Review.png`
        : "Umang-Review-Website-Wishes-All-Reviews.png";
      deliverExportBlob(blob, filename).catch(error => {
        notice(el("feedbackNotice"), "Could not deliver the review image: " + (error.message || "Please try again."), "error");
      });
    }
    function roundRect(ctx,x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}
    function wrapCanvasText(ctx,text,x,y,maxWidth,lineHeight){const words=text.split(/\s+/);let line="";for(const word of words){const test=line?line+" "+word:word;if(ctx.measureText(test).width>maxWidth&&line){ctx.fillText(line,x,y);line=word;y+=lineHeight;}else line=test;}if(line)ctx.fillText(line,x,y);}

    async function refreshVisitorStats(){
      ["totalViews","todayViews","weekViews"].forEach(id=>{if(el(id))el(id).textContent="…";});
      try{
        const totalResult = await client.from("site_stats")
          .select("id", { count: "exact", head: true })
          .eq("event_type", "page_view");
        if(totalResult.error) throw totalResult.error;
        el("totalViews").textContent=String(totalResult.count ?? 0);

        const now = new Date();
        const localMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const todayResult = await client.from("site_stats")
          .select("id", { count: "exact", head: true })
          .eq("event_type", "page_view")
          .gte("created_at", localMidnight.toISOString());
        if(todayResult.error) throw todayResult.error;
        el("todayViews").textContent=String(todayResult.count ?? 0);

        const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
        const weekResult = await client.from("site_stats")
          .select("id", { count: "exact", head: true })
          .eq("event_type", "page_view")
          .gte("created_at", sevenDaysAgo.toISOString());
        if(weekResult.error) throw weekResult.error;
        el("weekViews").textContent=String(weekResult.count ?? 0);
      }catch(e){
        ["totalViews","todayViews","weekViews"].forEach(id=>{if(el(id))el(id).textContent="—";});
        console.error("Could not load visitor statistics:", e.message || e);
        notice(el("globalNotice"),"Visitor statistics could not load: "+(e.message||"Check the site_stats SELECT policy for authenticated admins."),"error");
      }
    }
    const defaults={
      about:{title:"About Me",name:"",role:"",university:"",description:"",skills:[],image:""},
      projects:[{title:"",description:"",tech:[],link:"",image:""}],
      education:[{title:"",date:"",description:"",image:""}],
      skills:[{title:"",date:"",description:""}],
      experience:[{title:"",date:"",description:"",image:""}],
      certificates:[{title:"",date:"",image:""}],
      events:[{title:"",date:"",images:[]}],
      resume:{title:"Resume",url:""},
      notices:[{text:""}],
      site_settings:{name:"Umang Kakkad",role:"Software Developer & MCA Student",university:"GLS University, Ahmedabad",heroTitle:"Welcome to the Official Portfolio of",heroDescription:"",primaryColor:"#003399",accentColor:"#FF9900"}
    };
    function escapeHtml(v){return String(v??"").replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
    function field(label,key,value,type="text",placeholder=""){
      return `<label>${label}</label><input data-key="${key}" type="${type}" value="${escapeHtml(value)}" placeholder="${escapeHtml(placeholder)}">`;
    }
    function textareaField(label,key,value){return `<label>${label}</label><textarea data-key="${key}" style="min-height:100px;font-family:Inter,Arial,sans-serif" placeholder="Enter ${label.toLowerCase()}">${escapeHtml(value)}</textarea>`;}
    function uploadField(label,key,value,accept="image/*"){
      return `<label>${label}</label><input data-upload="${key}" type="file" accept="${accept}"><input data-key="${key}" type="url" value="${escapeHtml(value)}" placeholder="Uploaded file URL will appear here">${value?`<p class="help">Current file: <a href="${escapeHtml(value)}" target="_blank" rel="noopener">Open current file</a></p>`:""}`;
    }
    function renderForm(){
      const host=el("formEditor");host.innerHTML="";el("addItemBtn").classList.toggle("hidden",!Array.isArray(currentContent));
      if(currentSection==="about"){
        const d=currentContent||{};host.innerHTML=field("Section title","title",d.title||"About Me")+field("Your name","name",d.name||"")+field("Role / headline","role",d.role||"")+field("University","university",d.university||"")+textareaField("About description","description",d.description||"")+field("Skills (separate with commas)","skills",Array.isArray(d.skills)?d.skills.join(", "):"")+uploadField("Profile image","image",d.image||"");
      }else if(currentSection==="resume"){
        const d=currentContent||{};host.innerHTML=field("Resume section title","title",d.title||"Resume")+uploadField("Upload resume PDF","url",d.url||"",".pdf,application/pdf");
      }else if(currentSection==="notices"){
        const items=Array.isArray(currentContent)?currentContent:[{text:currentContent?.text||""}];
        host.innerHTML=items.map((d,i)=>`<div class="card" data-item="${i}" style="margin-bottom:16px;padding:18px"><div class="editor-head"><h2>Update ${i+1}</h2><button type="button" class="btn btn-danger remove-item" data-index="${i}">✕ Delete Update</button></div>${textareaField("Update message","text",d.text||"")}</div>`).join("");
        host.querySelectorAll(".remove-item").forEach(b=>b.addEventListener("click",()=>{if(confirm("Delete this update? Click Save / Update Changes to confirm the deletion in Supabase.")){currentContent.splice(Number(b.dataset.index),1);renderForm();}}));
      }else if(currentSection==="site_settings"){
        const d=currentContent||{};host.innerHTML=field("Portfolio name","name",d.name||"Umang Kakkad")+field("Role / headline","role",d.role||"")+field("University","university",d.university||"")+field("Hero heading","heroTitle",d.heroTitle||"")+textareaField("Hero description","heroDescription",d.heroDescription||"")+field("Primary blue color (hex)","primaryColor",d.primaryColor||"#003399")+field("Accent orange color (hex)","accentColor",d.accentColor||"#FF9900");
      }else{
        const items=Array.isArray(currentContent)?currentContent:[{...defaults[currentSection][0]}];
        host.innerHTML=items.map((d,i)=>`<div class="card" data-item="${i}" style="margin-bottom:16px;padding:18px"><div class="editor-head"><h2>${currentSection.slice(0,-1).replace(/^./,c=>c.toUpperCase())} ${i+1}</h2><button type="button" class="btn btn-danger remove-item" data-index="${i}">✕ Remove Record</button></div>`+
          field("Title / name","title",d.title||"")+
          (["projects","education","skills","experience"].includes(currentSection)?textareaField("Description / details","description",d.description||""):"")+
          (currentSection==="projects"?field("Technologies (comma separated)","tech",Array.isArray(d.tech)?d.tech.join(", "):"")+field("Project link","link",d.link||"","url"):"")+
          (["certificates","events","education","experience","skills"].includes(currentSection)?field("Date / subtitle (optional)","date",d.date||""):"")+
          (currentSection==="certificates"?uploadField("Certificate image","image",d.image||""):"")+
          (["projects","education","experience"].includes(currentSection)?uploadField("Image (optional)","image",d.image||""):"")+
          (currentSection==="events"?textareaField("Event photo URLs (one per line)","images",Array.isArray(d.images)?d.images.join("\n"):"") + uploadField("Upload another event photo","eventImage","","image/*"):"")+
          `</div>`).join("");
        host.querySelectorAll(".remove-item").forEach(b=>b.addEventListener("click",()=>{if(confirm("Remove this record from the editor? Click Save / Update Changes to save the deletion to Supabase.")){currentContent.splice(Number(b.dataset.index),1);renderForm();}}));
      }
      host.querySelectorAll("input[type=file]").forEach(inp=>inp.addEventListener("change",()=>uploadSelectedFile(inp)));
    }
    async function uploadSelectedFile(input){
      const file=input.files&&input.files[0];if(!file)return;
      if(file.size>15*1024*1024){notice(el("editorNotice"),"Please choose a file smaller than 15 MB.","error");input.value="";return;}
      const key=input.dataset.upload;const urlInput=input.parentElement.querySelector(`[data-key="${key}"]`);
      const safeName=file.name.replace(/[^a-zA-Z0-9._-]/g,"-");const path=`${currentUserId}/${Date.now()}-${safeName}`;
      input.disabled=true;notice(el("editorNotice"),"Uploading file…","info");
      try{
        const {error}=await client.storage.from(STORAGE_BUCKET).upload(path,file,{upsert:false,contentType:file.type||"application/octet-stream"});if(error)throw error;
        const {data}=client.storage.from(STORAGE_BUCKET).getPublicUrl(path);if(currentSection==="events"&&key==="eventImage"){const listInput=input.closest("[data-item]")?.querySelector('[data-key="images"]');if(listInput){const values=listInput.value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean);values.push(data.publicUrl);listInput.value=[...new Set(values)].join("\n");}}else{urlInput.value=data.publicUrl;}
        notice(el("editorNotice"),"Upload complete. The file URL is filled in; click Save / Update Changes to store it in the section.","success");
      }catch(e){notice(el("editorNotice"),"Upload failed: "+(e.message||"Unknown error")+". Check that the Supabase Storage bucket exists and its upload policy allows signed-in admins.","error");}
      finally{input.disabled=false;}
    }
    async function openSection(section){
      if(!defaults[section])return;el("galleryPage").classList.add("hidden");currentSection=section;document.querySelectorAll(".nav-btn").forEach(b=>b.classList.toggle("active",b.dataset.section===section));el("overviewPage").classList.add("hidden");el("editorPage").classList.remove("hidden");el("editorTitle").textContent=({about:"About Me",projects:"Projects",education:"Academics",skills:"Skills",experience:"Experience",certificates:"Certificates",events:"Events & Gallery",resume:"Resume",notices:"Latest Updates",site_settings:"Site Settings"})[section];el("editorSubtitle").textContent="Edit details and upload files using the form below.";el("recordStatus").textContent="LOADING";clearNotice(el("editorNotice"));await loadSection();
    }
    async function loadSection(){const b=el("loadBtn");b.disabled=true;try{
      const {data,error}=await client.from("portfolio_content").select("section,content,updated_at").eq("section",currentSection).maybeSingle();if(error)throw error;
      currentContent=data?data.content:JSON.parse(JSON.stringify(defaults[currentSection]));
      if(currentSection==="about"&&!Array.isArray(currentContent))currentContent={...defaults.about,...currentContent};
      if(["projects","certificates","events","notices"].includes(currentSection)&&!Array.isArray(currentContent))currentContent=[currentSection==="notices"?{text:currentContent?.text||""}:currentContent];
      el("recordStatus").textContent=data?"SAVED IN DATABASE":"NEW SECTION";renderForm();notice(el("editorNotice"),data?"Loaded saved details. Edit, add or remove records, then click Save / Update Changes.":"No saved record exists for this section yet. Add details and click Save / Update Changes.",data?"success":"info");
    }catch(e){el("recordStatus").textContent="LOAD FAILED";notice(el("editorNotice"),"Could not load this section: "+(e.message||"Unknown error"),"error");}finally{b.disabled=false;}}
    function collectForm(){
      if(currentSection==="about"){
        const d={};el("formEditor").querySelectorAll("[data-key]").forEach(i=>d[i.dataset.key]=i.value.trim());d.skills=(d.skills||"").split(",").map(x=>x.trim()).filter(Boolean);return d;
      }
      if(["resume","site_settings"].includes(currentSection)){const d={};el("formEditor").querySelectorAll("[data-key]").forEach(i=>d[i.dataset.key]=i.value.trim());return d;}
      if(currentSection==="notices"){return [...el("formEditor").querySelectorAll("[data-item]")].map(card=>({text:card.querySelector('[data-key="text"]')?.value.trim()||""}));}
      return [...el("formEditor").querySelectorAll("[data-item]")].map(card=>{const d={};card.querySelectorAll("[data-key]").forEach(i=>d[i.dataset.key]=i.value.trim());if(currentSection==="projects")d.tech=(d.tech||"").split(",").map(x=>x.trim()).filter(Boolean);if(currentSection==="events"){d.images=(card.querySelector('[data-key="images"]')?.value||"").split(/\r?\n/).map(x=>x.trim()).filter(Boolean);delete d.eventImage;}return d;});
    }
    async function saveSection(){clearNotice(el("editorNotice"));const button=el("saveBtn");const sticky=el("stickySaveBtn");button.disabled=true;sticky.disabled=true;button.textContent="Saving…";sticky.textContent="Saving…";try{
      const {data:sessionData}=await client.auth.getSession();if(!sessionData.session||sessionData.session.user.id!==currentUserId)throw new Error("Your admin session expired. Please log in again.");
      const parsed=collectForm();const {error}=await client.from("portfolio_content").upsert({section:currentSection,content:parsed,updated_at:new Date().toISOString()},{onConflict:"section"});if(error)throw error;
      currentContent=parsed;el("recordStatus").textContent="SAVED";
      // Verify that the public website can read the saved section with its public key.
      let publicReadable=false;
      try{
        const publicCheck=await fetch(SUPABASE_URL.replace(/\/$/,"")+"/rest/v1/portfolio_content?select=section,content&section=eq."+encodeURIComponent(currentSection),{
          headers:{apikey:SUPABASE_PUBLISHABLE_KEY,Authorization:"Bearer "+SUPABASE_PUBLISHABLE_KEY,Accept:"application/json"},cache:"no-store"
        });
        publicReadable=publicCheck.ok;
      }catch(_e){ publicReadable=false; }
      if(publicReadable){
        notice(el("editorNotice"),"✓ Update saved successfully! The website can read this data. Refresh the live website (Ctrl + F5) to see the changes.","success");
      }else{
        notice(el("editorNotice"),"✓ Saved to the database, but the public website cannot read this section yet. Check Supabase Row Level Security (RLS): allow public SELECT on portfolio_content. The dashboard design and saved data are unchanged.","info");
      }
      await refreshOverview();
    }catch(e){notice(el("editorNotice"),"Save failed: "+(e.message||"Unknown error")+". Check admin INSERT/UPDATE policies in Supabase.","error");}finally{button.disabled=false;sticky.disabled=false;button.textContent="Save / Update Changes";sticky.textContent="✓ Save / Update Changes";}}
    async function loadStorageGallery(){
      const host=el("storageGallery"); host.innerHTML='<p class="sub">Loading images…</p>'; clearNotice(el("galleryNotice"));
      try{
        const {data,error}=await client.storage.from(STORAGE_BUCKET).list("",{limit:1000,sortBy:{column:"name",order:"asc"}});
        if(error) throw error;
        const files=(data||[]).filter(x=>x.name && !x.id?false:true).filter(x=>x.name && !x.name.endsWith("/"));
        const imageFiles=files.filter(f=>/\.(png|jpe?g|gif|webp|svg|avif|bmp)$/i.test(f.name));
        if(!imageFiles.length){host.innerHTML='<p class="sub">No images found at the bucket root. This gallery currently lists root-level images; files inside folders may need opening by folder.</p>';return;}
        host.innerHTML=imageFiles.map(f=>{const url=client.storage.from(STORAGE_BUCKET).getPublicUrl(f.name).data.publicUrl;return `<article class="gallery-item"><a href="${escapeHtml(url)}" target="_blank" rel="noopener"><img src="${escapeHtml(url)}" alt="${escapeHtml(f.name)}" loading="lazy"></a><div class="gallery-name">${escapeHtml(f.name)}</div><div class="actions"><button class="btn btn-secondary copy-image-url" data-url="${escapeHtml(url)}" type="button">Copy URL</button><button class="btn btn-danger delete-storage-image" data-name="${escapeHtml(f.name)}" type="button">Delete image</button></div></article>`;}).join("");
        host.querySelectorAll(".copy-image-url").forEach(b=>b.addEventListener("click",async()=>{try{await navigator.clipboard.writeText(b.dataset.url);notice(el("galleryNotice"),"Image URL copied.","success");}catch(e){notice(el("galleryNotice"),b.dataset.url,"info");}}));
        host.querySelectorAll(".delete-storage-image").forEach(b=>b.addEventListener("click",async()=>{if(!confirm(`Permanently delete ${b.dataset.name} from Supabase Storage? Any page using this image URL will stop showing it.`))return;try{const {error}=await client.storage.from(STORAGE_BUCKET).remove([b.dataset.name]);if(error)throw error;await loadStorageGallery();notice(el("galleryNotice"),"Image deleted from Supabase Storage.","success");}catch(e){notice(el("galleryNotice"),"Delete failed: "+(e.message||"Unknown error"),"error");}}));
      }catch(e){host.innerHTML='';notice(el("galleryNotice"),"Could not load Storage images: "+(e.message||"Check bucket SELECT/list policy."),"error");}
    }

    // FAQ manager: table expected to have id, question, answer, category,
    // display_order, is_published. Database RLS must restrict writes to admins.
    let faqRows = [];
    const faqColumns = "id,question,answer,category,display_order,is_published";
    function resetFaqForm(){
      el("faqId").value=""; el("faqQuestion").value=""; el("faqAnswer").value="";
      el("faqCategory").value="General"; el("faqOrder").value="0"; el("faqPublished").checked=false;
      el("faqFormTitle").textContent="Add a new FAQ"; el("saveFaqBtn").textContent="Save FAQ";
    }
    function renderFaqs(){
      const query=(el("faqSearch").value||"").trim().toLowerCase();
      const rows=faqRows.filter(row=>[row.question,row.answer,row.category].some(v=>String(v||"").toLowerCase().includes(query)));
      el("faqCount").textContent=`${faqRows.length} FAQ${faqRows.length===1?"":"S"}`;
      if(!rows.length){el("faqList").innerHTML='<div class="record-list-note">No FAQs match this search. Add a new FAQ using the form above.</div>';return;}
      el("faqList").innerHTML=rows.map(row=>`<article class="faq-admin-row" data-faq-row="${escapeHtml(row.id)}">
        <div class="faq-admin-question">${escapeHtml(row.question||"(No question)")}</div>
        <div class="faq-admin-answer">${escapeHtml(row.answer||"")}</div>
        <div class="faq-admin-meta"><span class="status-pill">${escapeHtml(row.category||"General")}</span><span class="status-pill">${row.is_published?"PUBLISHED":"DRAFT"}</span><span class="status-pill">Order: ${Number(row.display_order)||0}</span></div>
        <div class="faq-admin-actions"><button type="button" class="btn btn-secondary" data-faq-edit="${escapeHtml(row.id)}">✎ Edit</button><button type="button" class="btn btn-secondary" data-faq-toggle="${escapeHtml(row.id)}">${row.is_published?"Unpublish":"Publish"}</button><button type="button" class="btn btn-danger" data-faq-delete="${escapeHtml(row.id)}">Delete</button></div>
      </article>`).join("");
      el("faqList").querySelectorAll("[data-faq-edit]").forEach(btn=>btn.addEventListener("click",()=>{
        const row=faqRows.find(item=>String(item.id)===btn.dataset.faqEdit);if(!row)return;
        el("faqId").value=row.id;el("faqQuestion").value=row.question||"";el("faqAnswer").value=row.answer||"";
        el("faqCategory").value=row.category||"General";el("faqOrder").value=Number(row.display_order)||0;el("faqPublished").checked=!!row.is_published;
        el("faqFormTitle").textContent="Edit FAQ";el("saveFaqBtn").textContent="Update FAQ";el("faqQuestion").focus();window.scrollTo({top:0,behavior:"smooth"});
      }));
      el("faqList").querySelectorAll("[data-faq-toggle]").forEach(btn=>btn.addEventListener("click",async()=>{
        const row=faqRows.find(item=>String(item.id)===btn.dataset.faqToggle);if(!row)return;
        btn.disabled=true;
        try{const {error}=await client.from("faq_items").update({is_published:!row.is_published}).eq("id",row.id);if(error)throw error;await loadFaqs();notice(el("faqNotice"),`FAQ ${row.is_published?"unpublished":"published"} successfully.`,"success");}
        catch(e){notice(el("faqNotice"),"Could not change publish status: "+(e.message||"Check FAQ table columns and admin UPDATE policy."),"error");btn.disabled=false;}
      }));
      el("faqList").querySelectorAll("[data-faq-delete]").forEach(btn=>btn.addEventListener("click",async()=>{
        const row=faqRows.find(item=>String(item.id)===btn.dataset.faqDelete);if(!row||!confirm("Permanently delete this FAQ?"))return;
        btn.disabled=true;
        try{const {error}=await client.from("faq_items").delete().eq("id",row.id);if(error)throw error;await loadFaqs();notice(el("faqNotice"),"FAQ deleted successfully.","success");}
        catch(e){notice(el("faqNotice"),"Could not delete FAQ: "+(e.message||"Check FAQ table and admin DELETE policy."),"error");btn.disabled=false;}
      }));
    }
    async function loadFaqs(){
      clearNotice(el("faqNotice"));el("faqList").innerHTML='<p class="sub">Loading FAQs…</p>';el("faqCount").textContent="LOADING";
      try{const {data,error}=await client.from("faq_items").select(faqColumns).order("display_order",{ascending:true}).order("id",{ascending:true});if(error)throw error;faqRows=data||[];renderFaqs();}
      catch(e){faqRows=[];el("faqCount").textContent="ERROR";el("faqList").innerHTML="";notice(el("faqNotice"),"Could not load FAQs: "+(e.message||"Check faq_items table columns and admin SELECT policy. Expected columns: id, question, answer, category, display_order, is_published."),"error");}
    }
    el("faqForm").addEventListener("submit",async event=>{
      event.preventDefault();clearNotice(el("faqNotice"));
      const question=el("faqQuestion").value.trim(),answer=el("faqAnswer").value.trim(),category=el("faqCategory").value.trim()||"General";
      const order=Number(el("faqOrder").value);
      if(!question||!answer){notice(el("faqNotice"),"Please enter both a question and an answer.","error");return;}
      if(!Number.isInteger(order)||order<0){notice(el("faqNotice"),"Display order must be a whole number, 0 or higher.","error");return;}
      const id=el("faqId").value;
      const payload={question,answer,category,display_order:order,is_published:el("faqPublished").checked};
      const btn=el("saveFaqBtn");btn.disabled=true;btn.textContent="Saving…";
      try{
        let result;
        if(id) result=await client.from("faq_items").update(payload).eq("id",id);
        else result=await client.from("faq_items").insert(payload);
        if(result.error)throw result.error;
        resetFaqForm();await loadFaqs();notice(el("faqNotice"),id?"FAQ updated successfully.":"FAQ added successfully.","success");
      }catch(e){notice(el("faqNotice"),"Could not save FAQ: "+(e.message||"Check faq_items table columns and admin INSERT/UPDATE policies."),"error");}
      finally{btn.disabled=false;btn.textContent=el("faqId").value?"Update FAQ":"Save FAQ";}
    });
    el("cancelFaqEditBtn").addEventListener("click",()=>{resetFaqForm();clearNotice(el("faqNotice"));});
    el("refreshFaqBtn").addEventListener("click",loadFaqs);
    el("faqSearch").addEventListener("input",renderFaqs);

    document.querySelectorAll(".nav-btn").forEach(button => button.addEventListener("click", async () => {
      const section=button.dataset.section;
      document.querySelectorAll(".nav-btn").forEach(item => item.classList.toggle("active", item === button));
      el("overviewPage").classList.add("hidden"); el("editorPage").classList.add("hidden"); el("galleryPage").classList.add("hidden"); el("feedbackPage").classList.add("hidden"); el("faqPage").classList.add("hidden");
      if(section === "overview"){ el("overviewPage").classList.remove("hidden"); await refreshOverview(); }
      else if(section === "image_gallery"){ el("galleryPage").classList.remove("hidden"); await loadStorageGallery(); }
      else if(section === "feedback"){ el("feedbackPage").classList.remove("hidden"); await loadFeedback(); }
      else if(section === "faq"){ el("faqPage").classList.remove("hidden"); await loadFaqs(); }
      else { el("editorPage").classList.remove("hidden"); await openSection(section); }
    }));
    el("goAboutBtn").addEventListener("click", () => openSection("about"));
    el("importWebsiteBtn")?.addEventListener("click", importExistingWebsiteContent);
    el("refreshOverviewBtn").addEventListener("click", refreshOverview);
    el("refreshGalleryBtn").addEventListener("click", loadStorageGallery);
    el("refreshFeedbackBtn").addEventListener("click", loadFeedback);
    el("downloadAllReviewsPdf").addEventListener("click", () => exportReviewsPdf(cachedFeedbackRows, false));
    el("downloadAllReviewsImage").addEventListener("click", () => exportReviewsImage(cachedFeedbackRows, false));
    setInterval(() => { if (client && !el("feedbackPage").classList.contains("hidden")) loadFeedback(); }, 30000);
    el("loadBtn").addEventListener("click", loadSection);
    el("saveBtn").addEventListener("click", saveSection);
    el("stickySaveBtn").addEventListener("click", async () => { if (!el("editorPage").classList.contains("hidden")) { await saveSection(); } else { notice(el("globalNotice"), "Choose a section first, then use Save / Update Changes.", "info"); } });
    el("addItemBtn").addEventListener("click",()=>{if(!Array.isArray(currentContent))return;currentContent.push(JSON.parse(JSON.stringify(defaults[currentSection][0]||{text:""})));renderForm();});
    el("logoutBtn").addEventListener("click", async () => {
      el("logoutBtn").disabled = true;
      try { if (client) await client.auth.signOut(); }
      finally { window.location.replace("login.html"); }
    });

    verifyAdmin().catch(error => {
      el("loadingMessage").textContent = error.message || "Could not verify admin access.";
      el("loadingMessage").className = "notice show error";
    });
  </script>
</body>
</html>