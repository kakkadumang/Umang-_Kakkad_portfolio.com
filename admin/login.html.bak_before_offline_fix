  <!-- SCRIPT -->
  <script>
    // Supabase Configuration
    const SUPABASE_URL = "https://rxbggmwzgbshmpjareav.supabase.co";
    const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_ptDO2uplwLjlJ2i-KCvkmA_1rcvyeGY";

    let supabaseClient = null;
    function getSb() {
      if (!supabaseClient && window.supabase) {
        supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, {
          auth: {
            persistSession: true,
            autoRefreshToken: true,
            detectSessionInUrl: true
          }
        });
      }
      return supabaseClient;
    }

    // Elements
    const loginView = document.getElementById("loginView");
    const forgotView = document.getElementById("forgotView");
    const loginForm = document.getElementById("loginForm");
    const forgotForm = document.getElementById("forgotForm");
    const loginEmail = document.getElementById("loginEmail");
    const loginPassword = document.getElementById("loginPassword");
    const loginSubmitBtn = document.getElementById("loginSubmitBtn");
    const loginBtnText = document.getElementById("loginBtnText");
    const togglePasswordBtn = document.getElementById("togglePasswordBtn");
    const eyeIcon = document.getElementById("eyeIcon");
    const statusMessage = document.getElementById("statusMessage");
    const backToLoginBtn = document.getElementById("backToLoginBtn");

    document.getElementById("yearVal").textContent = new Date().getFullYear();




    // Show / Hide Password toggle
    togglePasswordBtn.addEventListener("click", () => {
      const isPassword = loginPassword.type === "password";
      loginPassword.type = isPassword ? "text" : "password";
      eyeIcon.innerHTML = isPassword
        ? '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>'
        : '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
    });

    // Toggle views
    openForgotBtn.addEventListener("click", () => {
      loginView.hidden = true;
      forgotView.hidden = false;
      document.getElementById("forgotEmail").value = loginEmail.value.trim();
      clearMsg();
    });

    backToLoginBtn.addEventListener("click", () => {
      forgotView.hidden = true;
      loginView.hidden = false;
      clearMsg();
    });

    function showMsg(text, type = "error") {
      statusMessage.textContent = text;
      statusMessage.className = "status-msg show " + type;
    }

    function clearMsg() {
      statusMessage.textContent = "";
      statusMessage.className = "status-msg";
    }

    

    // HANDLE LOGIN SUBMIT
    loginForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearMsg();

      const email = loginEmail.value.trim();
      const password = loginPassword.value;

      if (!email || !password) {
        showMsg("Please enter both admin email and password.");
        return;
      }

      loginSubmitBtn.disabled = true;
      loginBtnText.textContent = "Verifying Credentials…";

      try {
        const client = getSb();
        if (!client) throw new Error("Supabase client is not available.");

        // Attempt Supabase Auth login
        const { data, error } = await client.auth.signInWithPassword({
          email: email,
          password: password
        });

        if (error) {
          throw error;
        }

        // Store session for smooth multi-page navigation across file:// and web
        const userData = {
          email: email,
          userId: data.user.id,
          loginTime: Date.now()
        };
        sessionStorage.setItem("umang_admin_user", JSON.stringify(userData));
        localStorage.setItem("umang_admin_user", JSON.stringify(userData));

        if (data.session) {
          try {
            sessionStorage.setItem("umang_supabase_session", JSON.stringify(data.session));
            localStorage.setItem("umang_supabase_session", JSON.stringify(data.session));
          } catch(_) {}
        }

        showMsg("✓ Login successful! Redirecting to Dashboard…", "success");

        setTimeout(() => {
          window.location.href = "dashboard.html";
        }, 500);

      } catch (err) {
        console.warn("Supabase auth response:", err);
        showMsg(err.message || "Invalid credentials. Please verify your email and password.");
        loginSubmitBtn.disabled = false;
        loginBtnText.textContent = "Sign In to Dashboard";
      }
    });

    // HANDLE FORGOT PASSWORD
    forgotForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearMsg();
      const fEmail = document.getElementById("forgotEmail").value.trim();
      const fBtn = document.getElementById("forgotSubmitBtn");

      fBtn.disabled = true;
      fBtn.textContent = "Sending link…";

      try {
        const client = getSb();
        if (!client) throw new Error("Database client offline.");
        const { error } = await client.auth.resetPasswordForEmail(fEmail, {
          redirectTo: window.location.origin + window.location.pathname
        });
        if (error) throw error;
        showMsg("✓ Password reset email sent! Please check your Inbox and Spam folder.", "success");
      } catch (err) {
        showMsg(err.message || "Could not send reset link. Try again later.");
      } finally {
        fBtn.disabled = false;
        fBtn.textContent = "Send Reset Email";
      }
    });

    // Initialize session banner check
    
  </script>
